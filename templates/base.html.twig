<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}SoftCore{% endblock %}</title>
        <link rel="icon" href="{{ asset('assets/images/softcore-logo.svg', 'vite') }}">
        
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% block header %}
        <header class="main-header fixed-top">
            <nav class="navbar navbar-expand-lg bg-white shadow-sm py-2 position-relative" data-bs-theme="light" aria-label="Navegación principal">
                <!-- Barra de acento naranja hasta la mitad del navbar -->
                <div class="navbar-accent-bar" aria-hidden="true"></div>
                <div class="container-fluid px-3 px-lg-5">
                    <!-- LOGO SVG compilado por Vite -->
                    <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
                        <img src="{{ asset('assets/images/softcore-logo.svg', 'vite') }}" alt="SoftCore" class="navbar-logo" height="58">
                    </a>

                    <!-- Acciones de Cabecera Móvil (Botón Consultoría compacto + Botón Hamburguesa) -->
                    <div class="d-flex align-items-center gap-2 d-lg-none">
                        <a href="{{ path('app_home') }}#consultoria" class="btn btn-consultoria btn-consultoria-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="btn-icon" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span data-i18n="nav.consultoria">Consultoría</span>
                        </a>
                        <button class="navbar-toggler collapsed" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#navbarMainCollapse" 
                                aria-controls="navbarMainCollapse" 
                                aria-expanded="false" 
                                aria-label="Abrir navegación">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>

                    <!-- Menú Navegación y Acciones -->
                    <div class="collapse navbar-collapse" id="navbarMainCollapse">
                        <div class="navbar-collapse-inner w-100 d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between">
                            <!-- Enlaces de Navegación -->
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                                <li class="nav-item">
                                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}" {% if app.request.attributes.get('_route') == 'app_home' %}aria-current="page"{% endif %} href="{{ path('app_home') }}">
                                        <span class="nav-link-title" data-i18n="nav.inicio">Inicio</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {% if app.request.attributes.get('_route') in ['app_about', 'app_about_es'] %}active{% endif %}" {% if app.request.attributes.get('_route') in ['app_about', 'app_about_es'] %}aria-current="page"{% endif %} href="{{ path('app_about') }}">
                                        <span class="nav-link-title" data-i18n="nav.quienes_somos">Quiénes Somos</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {% if app.request.attributes.get('_route') in ['app_services', 'app_services_es'] %}active{% endif %}" {% if app.request.attributes.get('_route') in ['app_services', 'app_services_es'] %}aria-current="page"{% endif %} href="{{ path('app_services') }}">
                                        <span class="nav-link-title" data-i18n="nav.servicios">Servicios</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {% if app.request.attributes.get('_route') in ['app_methodology', 'app_methodology_es'] %}active{% endif %}" {% if app.request.attributes.get('_route') in ['app_methodology', 'app_methodology_es'] %}aria-current="page"{% endif %} href="{{ path('app_methodology') }}">
                                        <span class="nav-link-title" data-i18n="nav.metodologia">Metodología</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_home') }}#tecnologias">
                                        <span class="nav-link-title" data-i18n="nav.tecnologias">Tecnologías</span>
                                    </a>
                                </li>
                            </ul>

                            <!-- Acciones Derecha: Botón Consultoría, WhatsApp e Idioma -->
                            <div class="navbar-actions d-flex align-items-center gap-3">
                                <a href="{{ path('app_home') }}#consultoria" class="btn btn-consultoria d-none d-lg-inline-flex">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="btn-icon" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <span data-i18n="nav.consultoria">Consultoría</span>
                                </a>
                                
                                <div class="navbar-actions-secondary d-flex align-items-center gap-2">
                                    <a href="https://wa.me/" class="btn-social btn-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Contacto por WhatsApp" title="WhatsApp">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
                                        </svg>
                                    </a>

                                    <a href="https://instagram.com/" class="btn-social btn-instagram" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Instagram" title="Instagram">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                        </svg>
                                    </a>

                                    <a href="https://facebook.com/" class="btn-social btn-facebook" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Facebook" title="Facebook">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 320 512" aria-hidden="true">
                                            <path d="M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4 .4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z"/>
                                        </svg>
                                    </a>

                                    <!-- Selector de Idioma: Un solo icono redondo que conmuta al dar click -->
                                    <button type="button" 
                                            class="btn btn-lang btn-lang-toggle" 
                                            id="languageToggle"
                                            data-controller="language-switcher"
                                            data-action="click->language-switcher#toggle"
                                            data-language-switcher-lang-value="es"
                                            data-language-switcher-es-flag-value="{{ asset('images/flags/es.svg') }}"
                                            data-language-switcher-us-flag-value="{{ asset('images/flags/us.svg') }}"
                                            title="Cambiar idioma (Click para alternar Español / English)" 
                                            aria-label="Cambiar idioma entre Español e Inglés">
                                        <img src="{{ asset('images/flags/es.svg') }}" 
                                             alt="Español" 
                                             class="flag-round-icon" 
                                             data-language-switcher-target="flag" 
                                             width="22" 
                                             height="22">
                                        <span class="lang-code" data-language-switcher-target="code">ES</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        {% endblock %}

        <main class="main-content">
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
        <footer class="main-footer bg-white border-top py-5" id="consultoria" aria-label="Pie de página">
            <div class="container">
                <div class="row g-4 justify-content-between">
                    <!-- Columna 1: Marca y descripción -->
                    <div class="col-12 col-md-4">
                        <a class="d-inline-flex align-items-center mb-3 text-decoration-none" href="{{ path('app_home') }}">
                            <img src="{{ asset('assets/images/softcore-logo.svg', 'vite') }}" alt="SoftCore" class="footer-logo" height="54">
                        </a>
                        <p class="text-muted small footer-desc mb-3" data-i18n="footer.desc">
                            Arquitectura de software de alto rendimiento, ingeniería cloud y desarrollo a medida para acelerar el crecimiento de tu empresa.
                        </p>
                    </div>

                    <!-- Columna 2: Enlaces Rápidos -->
                    <div class="col-6 col-md-2">
                        <h4 class="footer-heading mb-3" data-i18n="footer.heading_nav">Navegación</h4>
                        <ul class="list-unstyled footer-links mb-0">
                            <li><a href="{{ path('app_home') }}" data-i18n="nav.inicio">Inicio</a></li>
                            <li><a href="{{ path('app_about') }}" data-i18n="nav.quienes_somos">Quiénes Somos</a></li>
                            <li><a href="{{ path('app_services') }}" data-i18n="nav.servicios">Servicios</a></li>
                            <li><a href="{{ path('app_methodology') }}" data-i18n="nav.metodologia">Metodología</a></li>
                            <li><a href="{{ path('app_home') }}#tecnologias" data-i18n="nav.tecnologias">Tecnologías</a></li>
                        </ul>
                    </div>

                    <!-- Columna 3: Servicios -->
                    <div class="col-6 col-md-3">
                        <h4 class="footer-heading mb-3" data-i18n="footer.heading_services">Servicios</h4>
                        <ul class="list-unstyled footer-links mb-0">
                            <li><a href="{{ path('app_services') }}#software" data-i18n="services.card1_title">Desarrollo Web & Móvil</a></li>
                            <li><a href="{{ path('app_services') }}#cloud" data-i18n="services.card2_title">Cloud & DevOps</a></li>
                            <li><a href="{{ path('app_services') }}#consultoria-it" data-i18n="services.card3_title">Consultoría & Auditoría IT</a></li>
                            <li><a href="{{ path('app_services') }}#arquitectura" data-i18n="footer.serv_arch">Arquitectura de Software</a></li>
                        </ul>
                    </div>

                    <!-- Columna 4: Contacto y Redes Sociales -->
                    <div class="col-12 col-md-3">
                        <h4 class="footer-heading mb-3" data-i18n="footer.heading_contact">Contacto</h4>
                        <p class="text-muted small mb-3" data-i18n="footer.contact_desc">¿Tienes un proyecto en mente? Hablemos de cómo llevarlo al siguiente nivel.</p>
                        <div class="d-flex align-items-center gap-2">
                            <a href="https://wa.me/" class="btn-social btn-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Contacto por WhatsApp" title="WhatsApp">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"/>
                                </svg>
                            </a>
                            <a href="https://instagram.com/" class="btn-social btn-instagram" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Instagram" title="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>
                            <a href="https://facebook.com/" class="btn-social btn-facebook" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Facebook" title="Facebook">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 320 512" aria-hidden="true">
                                    <path d="M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4 .4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="footer-bottom border-top mt-4 pt-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-2 text-muted small">
                    <p class="mb-0">&copy; {{ "now"|date("Y") }} SoftCore. <span data-i18n="footer.rights">Todos los derechos reservados.</span></p>
                    <div class="d-flex gap-3">
                        <a href="#privacidad" class="text-muted text-decoration-none" data-i18n="footer.privacy">Privacidad</a>
                        <a href="#terminos" class="text-muted text-decoration-none" data-i18n="footer.terms">Términos</a>
                    </div>
                </div>
            </div>
        </footer>
        {% endblock %}
    </body>
</html>
