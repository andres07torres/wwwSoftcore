{% extends 'base.html.twig' %}

{% block title %}Servicios - SoftCorec | Soluciones de Ingeniería de Software & Cloud{% endblock %}
{% block meta_description %}Servicios de SoftCorec: desarrollo web y móvil a medida, arquitectura de software, ingeniería Cloud & DevOps y consultoría IT para tu empresa.{% endblock %}

{% block body %}
{% set has_config = services_config is defined and services_config is not null %}
<!-- =========================================================================
     1. HERO SECTION - SERVICIOS
     ========================================================================= -->
<section class="services-hero-section position-relative text-white" aria-labelledby="services-hero-title">
    <div class="services-hero-bg-overlay"></div>
    <div class="container position-relative py-0 py-lg-4">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-12 col-lg-7">
                {% if has_config %}
                    <h1 id="services-hero-title" class="services-hero-title mb-4">
                        {{ services_config.heroTitlePrefix }} <span class="text-gradient-light">{{ services_config.heroTitleHighlight }}</span>
                    </h1>

                    <p class="services-hero-subtitle text-white-50 mb-3 lead">
                        {{ services_config.heroSubtitle }}
                    </p>
                {% else %}
                    <h1 id="services-hero-title" class="services-hero-title mb-4" data-i18n-html="services_page.hero_title">
                        Servicios de ingeniería diseñados para <span class="text-gradient-light">escalar tu negocio</span>
                    </h1>

                    <p class="services-hero-subtitle text-white-50 mb-3 lead" data-i18n="services_page.hero_subtitle">
                        Acompañamos a tu empresa en cada fase del ciclo tecnológico: desde el diseño conceptual de arquitecturas robustas hasta el despliegue cloud automatizado y la optimización continua.
                    </p>
                {% endif %}

                <!-- Tira técnica de especializaciones clave (visible en tablet y desktop) -->
                <div class="services-hero-domains d-none d-md-flex flex-wrap gap-2 gap-md-3 mb-4 text-white-75 extra-small">
                    <span class="d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                        <span data-i18n="services_page.domain_software">Software & APIs</span>
                    </span>
                    <span class="text-white-25">•</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                        <span data-i18n="services_page.domain_cloud">Cloud DevOps</span>
                    </span>
                    <span class="text-white-25">•</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
                        <span data-i18n="services_page.domain_data">Bases de Datos</span>
                    </span>
                    <span class="text-white-25">•</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span data-i18n="services_page.domain_security">Ciberseguridad OWASP</span>
                    </span>
                </div>

                <div class="services-hero-actions d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mx-auto mx-lg-0">
                    <a href="#formulario-contacto" class="btn btn-hero-primary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="services_page.hero_btn_cta">Iniciar Proyecto</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                    <a href="#catalogo" class="btn btn-hero-outline-light btn-hero-secondary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="services_page.hero_btn_catalog">Explorar Soluciones</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="col-12 col-lg-5 d-none d-lg-block">
                <div class="services-hero-media position-relative">
                    <div class="services-img-frame rounded-4 overflow-hidden shadow-lg border border-white-15">
                        <img src="{{ has_config and services_config.heroImagePath ? services_config.heroImagePath : asset('assets/images/hero/hero-3.webp', 'vite') }}"
                             alt="{{ has_config and services_config.heroCaption ? services_config.heroCaption : 'Equipo de ingeniería de software y cloud de SoftCorec desarrollando soluciones' }}"
                             class="img-fluid w-100 services-hero-img"
                             loading="eager">
                        <div class="services-img-overlay"></div>
                    </div>
                    {% if has_config %}
                        <div class="services-hero-caption text-white-50 extra-small pt-2 text-center text-lg-end">
                            {{ services_config.heroCaption }}
                        </div>
                    {% else %}
                        <div class="services-hero-caption text-white-50 extra-small pt-2 text-center text-lg-end" data-i18n="services_page.hero_caption">
                            Desarrollo Full-Lifecycle & Arquitectura Cloud · SoftCorec
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. CATÁLOGO DE SERVICIOS ESPECIALIZADOS
     ========================================================================= -->
<section class="services-catalog-section py-5 py-lg-6 bg-light" id="catalogo" aria-labelledby="catalog-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            {% if has_config %}
                <span class="section-eyebrow">{{ services_config.catalogEyebrow }}</span>
                <h2 id="catalog-title" class="section-title">{{ services_config.catalogTitle }}</h2>
                <p class="section-subtitle text-muted">{{ services_config.catalogSubtitle }}</p>
            {% else %}
                <span class="section-eyebrow" data-i18n="services_page.catalog_eyebrow">Nuestro Portafolio</span>
                <h2 id="catalog-title" class="section-title" data-i18n="services_page.catalog_title">Soluciones diseñadas con rigor técnico</h2>
                <p class="section-subtitle text-muted" data-i18n="services_page.catalog_subtitle">
                    Arquitecturas escalables, código limpio y buenas prácticas de ingeniería para resolver desafíos de alto impacto.
                </p>
            {% endif %}
        </div>

        <div class="row g-4">
            {% if catalog_items is defined and catalog_items is not empty %}
                {% for item in catalog_items %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                            <div class="service-detail-icon-box mb-3">
                                {% if item.iconKey == 'cloud' %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                                {% elseif item.iconKey == 'mobile' %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                {% elseif item.iconKey == 'document' %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                {% elseif item.iconKey == 'database' %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                                {% elseif item.iconKey == 'lock' %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                {% else %}
                                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                                {% endif %}
                            </div>
                            <span class="service-category-badge mb-2">{{ item.category }}</span>
                            <h3 class="h5 service-card-title mb-3">{{ item.title }}</h3>
                            <p class="text-muted service-card-desc mb-3">{{ item.description }}</p>
                            <ul class="list-unstyled service-capabilities-list mb-4">
                                {% for cap in item.capabilitiesList %}
                                    <li>
                                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                        <span>{{ cap }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                            <div class="service-tech-tags mt-auto pt-3 border-top">
                                {% for tag in item.techTagsList %}
                                    <span class="tech-tag">{{ tag }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
            <!-- Servicio 1: Desarrollo de Software a Medida & APIs -->
            <div class="col-12 col-md-6 col-lg-4" id="software">
                <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="service-detail-icon-box mb-3">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                        </svg>
                    </div>
                    <span class="service-category-badge mb-2" data-i18n="services_page.serv1_cat">Desarrollo Core</span>
                    <h3 class="h5 service-card-title mb-3" data-i18n="services_page.serv1_title">Software a Medida & APIs</h3>
                    <p class="text-muted service-card-desc mb-3" data-i18n="services_page.serv1_desc">
                        Construimos backends robustos, arquitecturas limpias y APIs RESTful/GraphQL de alto rendimiento orientadas a operaciones críticas de negocio.
                    </p>
                    <ul class="list-unstyled service-capabilities-list mb-4">
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv1_cap1">Arquitecturas limpias (Hexagonal / DDD)</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv1_cap2">APIs RESTful y GraphQL escalables</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv1_cap3">Integración continua y tests automáticos</span>
                        </li>
                    </ul>
                    <div class="service-tech-tags mt-auto pt-3 border-top">
                        <span class="tech-tag">Symfony</span>
                        <span class="tech-tag">PHP</span>
                        <span class="tech-tag">Node.js</span>
                        <span class="tech-tag">PostgreSQL</span>
                    </div>
                </div>
            </div>

            <!-- Servicio 2: Cloud Architecture & DevOps -->
            <div class="col-12 col-md-6 col-lg-4" id="cloud">
                <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="service-detail-icon-box mb-3">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/>
                        </svg>
                    </div>
                    <span class="service-category-badge mb-2" data-i18n="services_page.serv2_cat">Infraestructura & Cloud</span>
                    <h3 class="h5 service-card-title mb-3" data-i18n="services_page.serv2_title">Cloud Architecture & DevOps</h3>
                    <p class="text-muted service-card-desc mb-3" data-i18n="services_page.serv2_desc">
                        Infraestructura como código y pipelines automatizados que eliminan la fricción operativa y garantizan disponibilidad continua.
                    </p>
                    <ul class="list-unstyled service-capabilities-list mb-4">
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv2_cap1">Infraestructura como Código (Terraform)</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv2_cap2">Contenedores con Kubernetes y Docker</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv2_cap3">Flujos CI/CD automatizados y seguros</span>
                        </li>
                    </ul>
                    <div class="service-tech-tags mt-auto pt-3 border-top">
                        <span class="tech-tag">AWS</span>
                        <span class="tech-tag">Kubernetes</span>
                        <span class="tech-tag">Docker</span>
                        <span class="tech-tag">Cloudflare</span>
                    </div>
                </div>
            </div>

            <!-- Servicio 3: Aplicaciones Web & Móviles -->
            <div class="col-12 col-md-6 col-lg-4" id="web-mobile">
                <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="service-detail-icon-box mb-3">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <span class="service-category-badge mb-2" data-i18n="services_page.serv3_cat">Frontend & UX</span>
                    <h3 class="h5 service-card-title mb-3" data-i18n="services_page.serv3_title">Aplicaciones Web & Móviles</h3>
                    <p class="text-muted service-card-desc mb-3" data-i18n="services_page.serv3_desc">
                        Interfaces de usuario reactivas, de carga ultra rápida y diseño intuitivo, optimizadas para la conversión y la retención del usuario.
                    </p>
                    <ul class="list-unstyled service-capabilities-list mb-4">
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv3_cap1">SPAs y plataformas interactivas</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv3_cap2">Optimización Core Web Vitals</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv3_cap3">Enfoque Mobile-First adaptable</span>
                        </li>
                    </ul>
                    <div class="service-tech-tags mt-auto pt-3 border-top">
                        <span class="tech-tag">React</span>
                        <span class="tech-tag">TypeScript</span>
                        <span class="tech-tag">Vite</span>
                        <span class="tech-tag">Bootstrap 5</span>
                    </div>
                </div>
            </div>

            <!-- Servicio 4: Consultoría & Auditoría IT -->
            <div class="col-12 col-md-6 col-lg-4" id="consultoria-it">
                <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="service-detail-icon-box mb-3">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                    </div>
                    <span class="service-category-badge mb-2" data-i18n="services_page.serv4_cat">Estrategia Tecnológica</span>
                    <h3 class="h5 service-card-title mb-3" data-i18n="services_page.serv4_title">Consultoría & Auditoría IT</h3>
                    <p class="text-muted service-card-desc mb-3" data-i18n="services_page.serv4_desc">
                        Diagnóstico integral de sistemas, identificación de cuellos de botella y mitigación de deuda técnica para asegurar estabilidad operativa.
                    </p>
                    <ul class="list-unstyled service-capabilities-list mb-4">
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv4_cap1">Auditoría de código y arquitectura</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv4_cap2">Planes de modernización de legado</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv4_cap3">Optimización de costos cloud</span>
                        </li>
                    </ul>
                    <div class="service-tech-tags mt-auto pt-3 border-top">
                        <span class="tech-tag">Code Review</span>
                        <span class="tech-tag">Profiling</span>
                        <span class="tech-tag">Refactoring</span>
                        <span class="tech-tag">OWASP</span>
                    </div>
                </div>
            </div>

            <!-- Servicio 5: Bases de Datos & Alta Concurrencia -->
            <div class="col-12 col-md-6 col-lg-4" id="databases">
                <div class="service-detail-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="service-detail-icon-box mb-3">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
                        </svg>
                    </div>
                    <span class="service-category-badge mb-2" data-i18n="services_page.serv5_cat">Persistencia & Datos</span>
                    <h3 class="h5 service-card-title mb-3" data-i18n="services_page.serv5_title">Bases de Datos & Rendimiento</h3>
                    <p class="text-muted service-card-desc mb-3" data-i18n="services_page.serv5_desc">
                        Modelado relacional avanzado, afinamiento de consultas SQL y capas de caché distribuido para sostener millones de transacciones.
                    </p>
                    <ul class="list-unstyled service-capabilities-list mb-4">
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv5_cap1">Indexación y afinamiento de queries</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv5_cap2">Caché de alto rendimiento con Redis</span>
                        </li>
                        <li>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-primary me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            <span data-i18n="services_page.serv5_cap3">Replicación y alta disponibilidad</span>
                        </li>
