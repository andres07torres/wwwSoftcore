                    </span>
                </div>

                <div class="services-hero-actions d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="#formulario-contacto" class="btn btn-hero-primary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="services_page.hero_btn_cta">Iniciar Proyecto</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
