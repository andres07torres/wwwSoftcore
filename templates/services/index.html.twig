<section class="projects-carousel-section py-5 py-lg-6 overflow-hidden" id="proyectos" aria-labelledby="projects-title">
    <div class="container mb-4 mb-lg-5">
        <div class="text-center max-w-700 mx-auto">
            {% if has_config %}
                <span class="section-eyebrow">{{ services_config.projectsEyebrow }}</span>
                <h2 id="projects-title" class="section-title">{{ services_config.projectsTitle }}</h2>
                <p class="section-subtitle text-muted mb-0">{{ services_config.projectsSubtitle }}</p>
            {% else %}
                <span class="section-eyebrow" data-i18n="services_page.projects_eyebrow">Proyectos Realizados</span>
                <h2 id="projects-title" class="section-title" data-i18n="services_page.projects_title">
                    Casos y soluciones construidas a medida
                </h2>
                <p class="section-subtitle text-muted mb-0" data-i18n="services_page.projects_subtitle">
                    Explora algunos de los sistemas, plataformas y arquitecturas que hemos diseñado y puesto en producción.
                </p>
            {% endif %}
        </div>
    </div>

    {% if projects_config is empty %}
        <div class="container">
            <div class="projects-empty-state text-center p-5 rounded-4 bg-white border">
                <p class="text-muted mb-0" data-i18n="services_page.projects_empty">
                    Próximamente publicaremos nuestros proyectos destacados.
                </p>
            </div>
        </div>
    {% else %}
        <!-- Carrusel continuo infinito (igual al de tecnologías en Inicio; se pausa al pasar el cursor) -->
        <div class="projects-marquee-wrapper" aria-label="Carrusel de proyectos realizados">
            <div class="projects-marquee-track">
                {% for copy in 1..2 %}
                    <div class="projects-marquee-group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
                        {% for project in projects_config %}
                            {% set image_src = '' %}
                            {% if project.imagen is defined and project.imagen %}
                                {% if project.imagen starts with 'http://' or project.imagen starts with 'https://' or project.imagen starts with '/' %}
                                    {% set image_src = project.imagen %}
                                {% else %}
                                    {% set image_src = asset(project.imagen, 'vite') %}
                                {% endif %}
                            {% endif %}

                            {% set is_external = project.url is defined and project.url and (project.url starts with 'http://' or project.url starts with 'https://') %}

                            <article class="project-slide">
                                <div class="project-card card h-100 border-0 rounded-4 overflow-hidden shadow-sm">
                                    <!-- Imagen o Placeholder del proyecto -->
                                    <div class="project-card-media position-relative overflow-hidden">
                                        {% if image_src %}
                                            <img src="{{ image_src }}"
                                                 alt="{{ copy == 1 ? project.imagen_alt|default(project.titulo) : '' }}"
                                                 class="project-card-img w-100 h-100"
                                                 loading="lazy">
                                        {% else %}
                                            <div class="project-card-placeholder d-flex flex-column align-items-center justify-content-center text-white text-center p-4">
                                                <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" class="mb-2 opacity-75" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                </svg>
                                                <span class="small fw-semibold opacity-75">{{ project.categoria|default('Proyecto') }}</span>
                                            </div>
                                        {% endif %}

                                        <div class="project-card-media-overlay" aria-hidden="true"></div>

                                        {% if project.categoria is defined and project.categoria %}
                                            <span class="project-category-pill">{{ project.categoria }}</span>
                                        {% endif %}

                                        {% if project.anio is defined and project.anio %}
                                            <span class="project-year-pill">{{ project.anio }}</span>
                                        {% endif %}
                                    </div>

                                    <!-- Contenido de la tarjeta -->
                                    <div class="project-card-body d-flex flex-column flex-grow-1 p-4">
                                        {% if project.cliente is defined and project.cliente %}
                                            <span class="project-client-label mb-1">{{ project.cliente }}</span>
                                        {% endif %}

                                        <h3 class="h5 project-card-title mb-2">{{ project.titulo }}</h3>

                                        <p class="text-muted project-card-desc mb-3">{{ project.descripcion }}</p>

                                        {% if project.metrica is defined and project.metrica %}
                                            <div class="project-metric-pill d-inline-flex align-items-center gap-2 mb-3">
                                                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                <span>{{ project.metrica }}</span>
                                            </div>
                                        {% endif %}

                                        <div class="mt-auto pt-3 border-top">
                                            {% if project.tecnologias is defined and project.tecnologias is not empty %}
                                                <div class="service-tech-tags mb-3">
                                                    {% for tech in project.tecnologias %}
                                                        <span class="tech-tag">{{ tech }}</span>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}

                                            {% if project.url is defined and project.url %}
                                                <a href="{{ project.url }}"
                                                   class="project-card-link d-inline-flex align-items-center gap-2 fw-semibold small text-decoration-none"
                                                   {% if copy == 2 %}tabindex="-1"{% endif %}
                                                   {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                                                    <span>{{ project.url_texto|default('Ver proyecto') }}</span>
                                                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                                    </svg>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</section>

<!-- =========================================================================
     3. MODELO DE TRABAJO Y ENTREGAS (WORKFLOW)
     ========================================================================= -->
<section class="workflow-section py-5 py-lg-6 bg-white" id="metodologia-servicio" aria-labelledby="workflow-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            {% if has_config %}
                <span class="section-eyebrow">{{ services_config.workflowEyebrow }}</span>
                <h2 id="workflow-title" class="section-title">{{ services_config.workflowTitle }}</h2>
                <p class="section-subtitle text-muted">{{ services_config.workflowSubtitle }}</p>
            {% else %}
                <span class="section-eyebrow" data-i18n="services_page.workflow_eyebrow">Cómo Trabajamos</span>
                <h2 id="workflow-title" class="section-title" data-i18n="services_page.workflow_title">Un proceso claro, predecible y orientado a resultados</h2>
                <p class="section-subtitle text-muted" data-i18n="services_page.workflow_subtitle">
                    De la conceptualización a la producción con transparencia total y validación rigurosa en cada hito.
                </p>
            {% endif %}
        </div>

        <div class="row g-4">
            {% if workflow_steps is defined and workflow_steps is not empty %}
                {% for step in workflow_steps %}
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="workflow-card p-4 rounded-4 h-100 border">
                            <div class="workflow-step-badge mb-3">{{ step.stepNumber }}</div>
                            <h3 class="h5 workflow-card-title mb-2">{{ step.title }}</h3>
                            <p class="text-muted small mb-0">{{ step.description }}</p>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
            <!-- Paso 1 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="workflow-card p-4 rounded-4 h-100 border">
                    <div class="workflow-step-badge mb-3">01</div>
                    <h3 class="h5 workflow-card-title mb-2" data-i18n="services_page.step1_title">Diagnóstico & Estrategia</h3>
                    <p class="text-muted small mb-0" data-i18n="services_page.step1_desc">
                        Analizamos tus requerimientos técnicos, evaluamos la arquitectura actual y definimos una propuesta de solución clara y viable.
                    </p>
                </div>
            </div>

            <!-- Paso 2 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="workflow-card p-4 rounded-4 h-100 border">
                    <div class="workflow-step-badge mb-3">02</div>
                    <h3 class="h5 workflow-card-title mb-2" data-i18n="services_page.step2_title">Desarrollo Iterativo</h3>
                    <p class="text-muted small mb-0" data-i18n="services_page.step2_desc">
                        Avanzamos en sprints ágiles con entregables funcionales, revisiones de código exhaustivas y comunicación continua.
                    </p>
                </div>
            </div>

            <!-- Paso 3 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="workflow-card p-4 rounded-4 h-100 border">
                    <div class="workflow-step-badge mb-3">03</div>
                    <h3 class="h5 workflow-card-title mb-2" data-i18n="services_page.step3_title">QA & Seguridad CI/CD</h3>
                    <p class="text-muted small mb-0" data-i18n="services_page.step3_desc">
                        Pruebas unitarias, de integración y escaneo de vulnerabilidades integrados en cada despliegue automatizado.
                    </p>
                </div>
            </div>

            <!-- Paso 4 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="workflow-card p-4 rounded-4 h-100 border">
                    <div class="workflow-step-badge mb-3">04</div>
                    <h3 class="h5 workflow-card-title mb-2" data-i18n="services_page.step4_title">Despliegue & Soporte</h3>
                    <p class="text-muted small mb-0" data-i18n="services_page.step4_desc">
                        Pase a producción sin tiempo de inactividad, monitoreo continuo del rendimiento y soporte proactivo post-lanzamiento.
                    </p>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</section>

