<style>
@font-face{font-family:"Montserrat";font-weight:500 800;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format("woff")}
:root{--navy:#0B1F4D;--orange:#FF7A00;--soft:#D3E1F1;--th:clamp(54px,10.5vh,120px)}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{overflow:hidden;font-family:"Montserrat",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;color:var(--navy);
  background:linear-gradient(135deg,#fff 0%,#E9F1FA 100%);position:relative}
.grid{position:fixed;inset:0;opacity:.75;
  background-image:linear-gradient(#D9E5F2 1.5px,transparent 1.5px),linear-gradient(90deg,#D9E5F2 1.5px,transparent 1.5px);
  background-size:60px 60px}

.gear{position:fixed;transform:translate(-50%,-50%);animation:spin 40s linear infinite}
.gear.fill{fill:var(--soft)}
.gear.line{fill:none;stroke-linejoin:round}
.g1{left:10%;top:70%;width:max(24vw,130px)}
.g2{left:92%;top:30%;width:max(20vw,110px);stroke:var(--orange);stroke-width:10;animation-direction:reverse;opacity:.9}
.g3{left:86%;top:81%;width:max(12.5vw,70px);animation-duration:30s}
.g4{left:17%;top:27%;width:max(10.5vw,60px);stroke:#B9CCE3;stroke-width:8;animation-duration:30s;animation-direction:reverse}
@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}

main{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;gap:clamp(10px,2vh,26px);padding:calc(var(--th) + 7vh) 5vw}
.logo{width:clamp(250px,32vw,680px);height:auto;margin-bottom:clamp(4px,1.5vh,20px)}
h1{font-weight:800;font-size:clamp(28px,5.3vw,104px);line-height:1.05;text-wrap:balance}
p{font-weight:500;font-size:clamp(15px,1.8vw,36px);color:#4A5B7A;max-width:34em;text-wrap:balance;line-height:1.4}
.progress{margin-top:clamp(10px,2.5vh,34px);width:clamp(240px,28vw,580px);height:clamp(16px,1.7vw,34px);border:3px solid var(--navy);
  border-radius:99px;background:var(--soft);overflow:hidden}
.progress i{display:block;height:100%;width:65%;--s:30px;
  background:linear-gradient(45deg,var(--orange) 25%,#FF9A3D 25% 50%,var(--orange) 50% 75%,#FF9A3D 75%);
  background-size:var(--s) var(--s);animation:stripes 1s linear infinite}
.label{font-weight:600;letter-spacing:.14em;font-size:clamp(11px,1.15vw,24px)}
@keyframes stripes{to{background-position-x:var(--s)}}

.tape{position:fixed;left:-6vw;width:112vw;height:var(--th);z-index:3;background:var(--navy);display:flex;flex-direction:column;
  overflow:hidden;box-shadow:0 10px 30px rgba(11,31,77,.28)}
.tape.top{top:4vh;transform:rotate(-2.5deg)}
.tape.bottom{bottom:4vh;transform:rotate(2.5deg)}
.edge{height:20%;--s:calc(var(--th)*.4);
  background:linear-gradient(45deg,var(--orange) 25%,var(--navy) 25% 50%,var(--orange) 50% 75%,var(--navy) 75%);
  background-size:var(--s) var(--s);animation:edge 1.4s linear infinite}
.bottom .edge{animation-direction:reverse}
@keyframes edge{to{background-position-x:var(--s)}}
.band{flex:1;display:flex;align-items:center;overflow:hidden}
.track{display:flex;flex:none;white-space:nowrap;font-weight:800;color:var(--orange);letter-spacing:.12em;
  font-size:clamp(15px,2.05vw,42px);animation:slide 26s linear infinite}
.bottom .track{animation-direction:reverse}
.track span::after{content:"•";margin:0 .9em}
@keyframes slide{to{transform:translateX(-50%)}}

@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
