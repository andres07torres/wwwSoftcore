{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard | Panel Administrativo SoftCorec{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block admin_content %}
    <div class="sc-page-header mb-4">
        <h1 class="sc-page-title mb-1">Dashboard</h1>
        <p class="sc-page-subtitle mb-0">Resumen general del contenido y estado del portal SoftCorec.</p>
    </div>

    <!-- 1. KPIs de contenido real -->
    <section class="row g-3 mb-4" aria-label="Indicadores clave">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sc-kpi-card">
                <div class="sc-kpi-header">
                    <span class="sc-kpi-label">Páginas editables</span>
                    <span class="sc-kpi-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                        </svg>
                    </span>
                </div>
                <div class="sc-kpi-value">{{ total_pages }}</div>
                <span class="sc-kpi-meta">{{ customized_pages }} de {{ total_pages }} con contenido personalizado</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sc-kpi-card">
                <div class="sc-kpi-header">
                    <span class="sc-kpi-label">Elementos publicados</span>
                    <span class="sc-kpi-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>
                        </svg>
                    </span>
                </div>
                <div class="sc-kpi-value">{{ published_items }}</div>
                <span class="sc-kpi-meta">{{ total_items > 0 ? total_items ~ ' registrados en módulos' : 'Usando contenido predeterminado' }}</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sc-kpi-card">
                <div class="sc-kpi-header">
                    <span class="sc-kpi-label">Usuarios</span>
                    <span class="sc-kpi-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
                        </svg>
                    </span>
                </div>
                <div class="sc-kpi-value">{{ total_users }}</div>
                <span class="sc-kpi-meta">{{ active_users }} {{ active_users == 1 ? 'activo' : 'activos' }} · {{ admins_count }} {{ admins_count == 1 ? 'admin' : 'admins' }}</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="sc-kpi-card">
                <div class="sc-kpi-header">
                    <span class="sc-kpi-label">Estado del portal</span>
                    <span class="sc-kpi-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
                        </svg>
                    </span>
                </div>
                <div class="sc-kpi-value sc-kpi-value-sm">{{ maintenance_active ? 'Mantenimiento' : 'Operativo' }}</div>
                <span class="sc-kpi-meta">SoftCorec Web Platform</span>
            </div>
        </div>
    </section>

    <!-- 2. Bloques operativos -->
    <div class="row g-4">
        <!-- Columna principal (Izquierda) -->
        <div class="col-12 col-xl-8 d-flex flex-column gap-4">
            <!-- Tabla de las 5 páginas del portal -->
            <section class="sc-panel-card" aria-label="Páginas del portal">
                <div class="sc-panel-card-header">
                    <div>
                        <h2 class="sc-panel-card-title">Páginas del portal</h2>
                        <p class="sc-panel-card-subtitle mb-0">Estado de personalización, elementos activos y acceso directo a edición.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Página</th>
                                <th scope="col">Elementos</th>
                                <th scope="col">Última edición</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for page in pages_overview %}
                                <tr>
                                    <td class="fw-semibold text-dark">{{ page.name }}</td>
                                    <td class="text-muted">{{ page.active_items }} {{ page.active_items == 1 ? 'activo' : 'activos' }}</td>
                                    <td class="text-muted">
                                        {{ page.updated_at ? page.updated_at|date('d/m/Y H:i', 'America/Guayaquil') : 'Sin cambios' }}
                                    </td>
                                    <td>
                                        <span class="sc-role-badge {{ page.customized ? '' : 'is-neutral' }}">
                                            {{ page.customized ? 'Personalizada' : 'Predeterminada' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path(page.edit_route) }}" class="btn sc-btn-primary btn-sm">Editar</a>
                                            <a href="{{ path(page.public_route) }}" class="btn sc-btn-outline btn-sm" target="_blank" rel="noopener noreferrer">Ver</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Distribución de contenido por página -->
            <section class="sc-panel-card" aria-label="Distribución de contenido por página">
                <div class="sc-panel-card-header">
                    <div>
                        <h2 class="sc-panel-card-title">Distribución de contenido por página</h2>
                        <p class="sc-panel-card-subtitle mb-0">Elementos activos registrados en base de datos por cada módulo.</p>
                    </div>
                </div>
                <div class="sc-panel-card-body">
                    <div class="d-flex flex-column gap-3">
                        {% for page in pages_overview %}
                            <div class="sc-bar-row">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="sc-bar-label">{{ page.name }}</span>
                                    <span class="sc-bar-count">{{ page.active_items }} / {{ page.total_items }}</span>
                                </div>
                                <div class="sc-bar-track" role="progressbar" aria-valuenow="{{ page.bar_pct }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ page.name }}">
                                    <div class="sc-bar-fill" style="width: {{ page.bar_pct }}%;"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </section>
        </div>

        <!-- Columna lateral (Derecha) -->
        <div class="col-12 col-xl-4 d-flex flex-column gap-4">
            <!-- Interruptor rápido de Modo Mantenimiento -->
            <section class="sc-panel-card" aria-label="Control de Modo Mantenimiento">
                <div class="sc-panel-card-header">
                    <div>
                        <h2 class="sc-panel-card-title">Modo Mantenimiento</h2>
                        <p class="sc-panel-card-subtitle mb-0">Control rápido de disponibilidad pública.</p>
                    </div>
                </div>
                <div class="sc-panel-card-body">
                    <div class="sc-maintenance-box {{ maintenance_active ? 'is-active' : '' }} mb-3">
                        <div class="fw-semibold text-dark mb-1">
                            {{ maintenance_active ? 'Mantenimiento activo' : 'Portal en línea' }}
                        </div>
                        <p class="small text-muted mb-0">
                            {{ maintenance_active
                                ? 'Los visitantes ven la página de mantenimiento. El panel administrativo sigue accesible.'
                                : 'El sitio público está visible para todos los visitantes con normalidad.' }}
                        </p>
                    </div>

                    {% if maintenance_env_forced %}
                        <p class="small text-muted mb-0">
                            Forzado mediante la variable de entorno <code>APP_MAINTENANCE=1</code>.
                        </p>
                    {% else %}
                        <form
                            method="post"
                            action="{{ path('app_admin_maintenance_toggle') }}"
                            onsubmit="return confirm('{{ maintenance_active ? '¿Desactivar el modo mantenimiento y volver a publicar el sitio?' : '¿Activar el modo mantenimiento para los visitantes del sitio público?' }}');"
                            class="d-flex justify-content-center"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_maintenance') }}">
                            <button type="submit" class="btn {{ maintenance_active ? 'sc-btn-primary' : 'sc-btn-danger-soft' }} btn-sm px-3">
                                {{ maintenance_active ? 'Desactivar mantenimiento' : 'Activar mantenimiento' }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </section>

            <!-- Sesión y estado del sistema -->
            <section class="sc-panel-card" aria-label="Sesión y sistema">
                <div class="sc-panel-card-header">
                    <div>
                        <h2 class="sc-panel-card-title">Sesión y sistema</h2>
                        <p class="sc-panel-card-subtitle mb-0">Información de tu cuenta y entorno.</p>
                    </div>
                </div>
                <div class="sc-panel-card-body">
                    <dl class="sc-system-list mb-3">
                        <div class="sc-system-item">
                            <dt>Usuario</dt>
                            <dd>{{ app.user.fullName }}</dd>
                        </div>
                        <div class="sc-system-item">
                            <dt>Correo</dt>
                            <dd>{{ app.user.email }}</dd>
                        </div>
                        <div class="sc-system-item">
                            <dt>Último acceso</dt>
                            <dd>{{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y H:i', 'America/Guayaquil') : 'Sesión actual' }}</dd>
                        </div>
                        <div class="sc-system-item">
                            <dt>Entorno</dt>
                            <dd class="text-uppercase">{{ app_env }} · PHP {{ php_version|split('.')|slice(0, 2)|join('.') }}</dd>
                        </div>
                    </dl>

                    <div class="sc-dashboard-actions d-flex flex-wrap justify-content-center align-items-center gap-2">
                        <a href="{{ path('app_admin_profile') }}" class="btn sc-btn-primary">Gestionar mi perfil</a>
                        <a href="{{ path('app_home') }}" class="btn sc-btn-outline" target="_blank" rel="noopener noreferrer">Ver sitio público</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
