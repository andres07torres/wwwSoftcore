{% extends 'admin/layout.html.twig' %}

{% block title %}Editar Quiénes Somos | Panel Administrativo SoftCorec{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block admin_content %}
    <div class="sc-page-header mb-4">
        <nav aria-label="Ruta de navegación" class="sc-breadcrumb">
            <a href="{{ path('app_admin_dashboard') }}">Panel</a>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span>Gestión de Contenido</span>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="sc-breadcrumb-current" aria-current="page">Quiénes Somos</span>
        </nav>
        <h1 class="sc-page-title mb-1">Quiénes Somos</h1>
        <p class="sc-page-subtitle mb-0">Secciones ordenadas según su aparición en la página pública de Quiénes Somos.</p>
    </div>

    <!-- Navegación rápida por orden de página -->
    <nav class="sc-section-nav mb-4" aria-label="Secciones de Quiénes Somos">
        <a href="#sec-hero" class="sc-section-pill">
            <span class="sc-section-num">1</span>
            <span>Hero</span>
        </a>
        <a href="#sec-proposito" class="sc-section-pill">
            <span class="sc-section-num">2</span>
            <span>Nuestro Propósito</span>
        </a>
        <a href="#sec-cultura" class="sc-section-pill">
            <span class="sc-section-num">3</span>
            <span>Cultura & Principios</span>
        </a>
        <a href="#sec-resultados" class="sc-section-pill">
            <span class="sc-section-num">4</span>
            <span>Resultados & Trayectoria</span>
        </a>
    </nav>

    <div class="d-flex flex-column gap-5">
        <!-- =================================================================
             1. HERO DE QUIÉNES SOMOS
             ================================================================= -->
        <div id="sec-hero" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 1</span>
                <h2 class="sc-section-group-title mb-0">Hero de Quiénes Somos</h2>
            </div>

            <section class="sc-panel-card" aria-labelledby="about-hero-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="about-hero-heading" class="sc-panel-card-title">1.1 Textos e imagen principal</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita el título, descripción e imagen lateral del encabezado.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(hero_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(hero_form.heroTitlePrefix, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroTitlePrefix) }}
                            {{ form_errors(hero_form.heroTitlePrefix) }}
                        </div>

                        <div class="col-12 col-lg-4">
                            {{ form_label(hero_form.heroTitleHighlight, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroTitleHighlight) }}
                            {{ form_errors(hero_form.heroTitleHighlight) }}
                        </div>

                        <div class="col-12 col-lg-4">
                            {{ form_label(hero_form.heroTitleSuffix, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroTitleSuffix) }}
                            {{ form_errors(hero_form.heroTitleSuffix) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(hero_form.heroSubtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroSubtitle) }}
                            {{ form_errors(hero_form.heroSubtitle) }}
                        </div>

                        <div class="col-12 col-md-6">
                            {{ form_label(hero_form.heroImageFile, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroImageFile) }}
                            {{ form_errors(hero_form.heroImageFile) }}
                        </div>

                        <div class="col-12 col-md-6">
                            {{ form_label(hero_form.heroCaption, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.heroCaption) }}
                            {{ form_errors(hero_form.heroCaption) }}
                        </div>

                        {% if config.heroImagePath %}
                            <div class="col-12">
                                <span class="form-label sc-form-label d-block">Imagen actual</span>
                                <img src="{{ config.heroImagePath }}" alt="{{ config.heroCaption }}" class="sc-slide-preview-lg">
                            </div>
                        {% endif %}

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        </div>
                    {{ form_end(hero_form) }}
                </div>
            </section>
        </div>

        <!-- =================================================================
             2. NUESTRO PROPÓSITO (MISIÓN & VISIÓN)
             ================================================================= -->
        <div id="sec-proposito" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 2</span>
                <h2 class="sc-section-group-title mb-0">Nuestro Propósito (Misión y Visión)</h2>
            </div>

            <section class="sc-panel-card" aria-labelledby="about-purpose-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="about-purpose-heading" class="sc-panel-card-title">2.1 Encabezado, Misión y Visión</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita los textos del encabezado y las tarjetas de Misión y Visión.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(purpose_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(purpose_form.purposeEyebrow, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.purposeEyebrow) }}
                            {{ form_errors(purpose_form.purposeEyebrow) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(purpose_form.purposeTitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.purposeTitle) }}
                            {{ form_errors(purpose_form.purposeTitle) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(purpose_form.purposeSubtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.purposeSubtitle) }}
                            {{ form_errors(purpose_form.purposeSubtitle) }}
                        </div>

                        <div class="col-12"><hr class="my-2"></div>

                        <div class="col-12 col-lg-4">
                            {{ form_label(purpose_form.missionBadge, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.missionBadge) }}
                            {{ form_errors(purpose_form.missionBadge) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(purpose_form.missionTitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.missionTitle) }}
                            {{ form_errors(purpose_form.missionTitle) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(purpose_form.missionDescription, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.missionDescription) }}
                            {{ form_errors(purpose_form.missionDescription) }}
                        </div>

                        <div class="col-12"><hr class="my-2"></div>

                        <div class="col-12 col-lg-4">
                            {{ form_label(purpose_form.visionBadge, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.visionBadge) }}
                            {{ form_errors(purpose_form.visionBadge) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(purpose_form.visionTitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.visionTitle) }}
                            {{ form_errors(purpose_form.visionTitle) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(purpose_form.visionDescription, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(purpose_form.visionDescription) }}
                            {{ form_errors(purpose_form.visionDescription) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        </div>
                    {{ form_end(purpose_form) }}
                </div>
            </section>
        </div>

        <!-- =================================================================
             3. CULTURA & PRINCIPIOS
             ================================================================= -->
        <div id="sec-cultura" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 3</span>
                <h2 class="sc-section-group-title mb-0">Cultura & Principios</h2>
            </div>

            <section class="sc-panel-card" aria-labelledby="about-values-header-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="about-values-header-heading" class="sc-panel-card-title">3.1 Encabezado de Cultura & Principios</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita la etiqueta superior, título y subtítulo de la sección.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(values_header_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(values_header_form.valuesEyebrow, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(values_header_form.valuesEyebrow) }}
                            {{ form_errors(values_header_form.valuesEyebrow) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(values_header_form.valuesTitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(values_header_form.valuesTitle) }}
                            {{ form_errors(values_header_form.valuesTitle) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(values_header_form.valuesSubtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(values_header_form.valuesSubtitle) }}
                            {{ form_errors(values_header_form.valuesSubtitle) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        </div>
                    {{ form_end(values_header_form) }}
                </div>
            </section>

            <section class="sc-panel-card" aria-labelledby="about-values-list-heading">
                <div class="sc-panel-card-header flex-wrap">
                    <div>
                        <h3 id="about-values-list-heading" class="sc-panel-card-title">3.2 Tarjetas de Principios</h3>
                        <p class="sc-panel-card-subtitle mb-0">
                            Si no hay principios activos registrados aquí, se mostrarán los 4 principios predeterminados.
                        </p>
                    </div>
                    <button type="button" class="btn sc-btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewAboutValue">
                        + Nuevo principio
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Título</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Orden</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for card in value_cards %}
                                <tr>
                                    <td class="fw-semibold text-dark">{{ card.title }}</td>
                                    <td class="text-muted">{{ card.description|length > 90 ? card.description|slice(0, 90) ~ '…' : card.description }}</td>
                                    <td>{{ card.sortOrder }}</td>
                                    <td>
                                        <span class="sc-status-pill {{ card.isActive ? 'is-online' : 'is-warning' }}">
                                            <span class="sc-status-dot" aria-hidden="true"></span>
                                            {{ card.isActive ? 'Activo' : 'Oculto' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path('app_admin_about_value_edit', { id: card.id }) }}" class="btn sc-btn-outline btn-sm">Editar</a>
                                            <form method="post" action="{{ path('app_admin_about_value_delete', { id: card.id }) }}" onsubmit="return confirm('¿Eliminar este principio?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_about_value_' ~ card.id) }}">
                                                <button type="submit" class="btn sc-btn-danger-soft btn-sm">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Aún no hay principios personalizados. La página pública usa los 4 principios predeterminados.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- =================================================================
             4. RESULTADOS & TRAYECTORIA
             ================================================================= -->
        <div id="sec-resultados" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 4</span>
                <h2 class="sc-section-group-title mb-0">Resultados & Trayectoria</h2>
            </div>

            <section class="sc-panel-card" aria-labelledby="about-metrics-header-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="about-metrics-header-heading" class="sc-panel-card-title">4.1 Encabezado de Resultados & Trayectoria</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita la etiqueta superior, título y subtítulo de la sección.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(metrics_header_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(metrics_header_form.metricsEyebrow, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(metrics_header_form.metricsEyebrow) }}
                            {{ form_errors(metrics_header_form.metricsEyebrow) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(metrics_header_form.metricsTitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(metrics_header_form.metricsTitle) }}
                            {{ form_errors(metrics_header_form.metricsTitle) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(metrics_header_form.metricsSubtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(metrics_header_form.metricsSubtitle) }}
                            {{ form_errors(metrics_header_form.metricsSubtitle) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        </div>
                    {{ form_end(metrics_header_form) }}
                </div>
            </section>

            <section class="sc-panel-card" aria-labelledby="about-metrics-list-heading">
                <div class="sc-panel-card-header flex-wrap">
                    <div>
                        <h3 id="about-metrics-list-heading" class="sc-panel-card-title">4.2 Tarjetas de Cifras</h3>
                        <p class="sc-panel-card-subtitle mb-0">
                            Si no hay cifras activas registradas aquí, se mostrarán las 4 cifras predeterminadas.
                        </p>
                    </div>
                    <button type="button" class="btn sc-btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewAboutMetric">
                        + Nueva cifra
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Cifra</th>
                                <th scope="col">Título</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for card in metric_cards %}
                                <tr>
                                    <td><span class="sc-role-badge">{{ card.value }}</span></td>
                                    <td class="fw-semibold text-dark">{{ card.label }}</td>
                                    <td class="text-muted">{{ card.description|length > 80 ? card.description|slice(0, 80) ~ '…' : card.description }}</td>
                                    <td>
                                        <span class="sc-status-pill {{ card.isActive ? 'is-online' : 'is-warning' }}">
                                            <span class="sc-status-dot" aria-hidden="true"></span>
                                            {{ card.isActive ? 'Activa' : 'Oculta' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path('app_admin_about_metric_edit', { id: card.id }) }}" class="btn sc-btn-outline btn-sm">Editar</a>
                                            <form method="post" action="{{ path('app_admin_about_metric_delete', { id: card.id }) }}" onsubmit="return confirm('¿Eliminar esta cifra?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_about_metric_' ~ card.id) }}">
                                                <button type="submit" class="btn sc-btn-danger-soft btn-sm">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Aún no hay cifras personalizadas. La página pública usa las 4 cifras predeterminadas.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <!-- Modal: Nuevo Principio -->
    <div class="modal fade sc-modal" id="modalNewAboutValue" tabindex="-1" aria-labelledby="modalNewAboutValueLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h3 class="modal-title sc-panel-card-title" id="modalNewAboutValueLabel">Nuevo principio</h3>
                        <p class="sc-panel-card-subtitle mb-0">Se mostrará en Cultura & Principios de Quiénes Somos.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                {{ form_start(new_value_form) }}
                    <div class="modal-body row g-3">
                        <div class="col-12 col-sm-5">
                            {{ form_label(new_value_form.iconKey, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_value_form.iconKey) }}
                            {{ form_errors(new_value_form.iconKey) }}
                        </div>
                        <div class="col-12 col-sm-7">
                            {{ form_label(new_value_form.title, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_value_form.title) }}
                            {{ form_errors(new_value_form.title) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(new_value_form.description, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_value_form.description) }}
                            {{ form_errors(new_value_form.description) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_value_form.sortOrder, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_value_form.sortOrder) }}
                            {{ form_errors(new_value_form.sortOrder) }}
                        </div>
                        <div class="col-12 col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                {{ form_widget(new_value_form.isActive) }}
                                {{ form_label(new_value_form.isActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        <button type="button" class="btn sc-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                {{ form_end(new_value_form) }}
            </div>
        </div>
    </div>

    <!-- Modal: Nueva Cifra -->
    <div class="modal fade sc-modal" id="modalNewAboutMetric" tabindex="-1" aria-labelledby="modalNewAboutMetricLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h3 class="modal-title sc-panel-card-title" id="modalNewAboutMetricLabel">Nueva cifra</h3>
                        <p class="sc-panel-card-subtitle mb-0">Se mostrará en Resultados & Trayectoria de Quiénes Somos.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                {{ form_start(new_metric_form) }}
                    <div class="modal-body row g-3">
                        <div class="col-12 col-sm-4">
                            {{ form_label(new_metric_form.value, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_metric_form.value) }}
                            {{ form_errors(new_metric_form.value) }}
                        </div>
                        <div class="col-12 col-sm-8">
                            {{ form_label(new_metric_form.label, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_metric_form.label) }}
                            {{ form_errors(new_metric_form.label) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(new_metric_form.description, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_metric_form.description) }}
                            {{ form_errors(new_metric_form.description) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_metric_form.sortOrder, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_metric_form.sortOrder) }}
                            {{ form_errors(new_metric_form.sortOrder) }}
                        </div>
                        <div class="col-12 col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                {{ form_widget(new_metric_form.isActive) }}
                                {{ form_label(new_metric_form.isActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button type="submit" class="btn sc-btn-primary">Guardar</button>
                        <button type="button" class="btn sc-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                {{ form_end(new_metric_form) }}
            </div>
        </div>
    </div>
{% endblock %}
