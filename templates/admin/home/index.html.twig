{% extends 'admin/layout.html.twig' %}

{% block title %}Editar Inicio | Panel Administrativo SoftCorec{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block admin_content %}
    <div class="sc-page-header mb-4">
        <nav aria-label="Ruta de navegación" class="sc-breadcrumb">
            <a href="{{ path('app_admin_dashboard') }}">Panel</a>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span>Gestión de Contenido</span>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="sc-breadcrumb-current" aria-current="page">Inicio</span>
        </nav>
        <h1 class="sc-page-title mb-1">Inicio</h1>
        <p class="sc-page-subtitle mb-0">Secciones ordenadas según su aparición en la portada pública de SoftCorec.</p>
    </div>

    <!-- Navegación rápida por orden de página -->
    <nav class="sc-section-nav mb-4" aria-label="Secciones de Inicio">
        <a href="#sec-hero" class="sc-section-pill">
            <span class="sc-section-num">1</span>
            <span>Hero y Carrusel</span>
        </a>
        <a href="#sec-pilares" class="sc-section-pill">
            <span class="sc-section-num">2</span>
            <span>Nuestros Pilares</span>
        </a>
        <a href="#sec-metodologia" class="sc-section-pill">
            <span class="sc-section-num">3</span>
            <span>Cómo Trabajamos</span>
        </a>
    </nav>

    <div class="d-flex flex-column gap-5">
        <!-- =================================================================
             1. HERO Y CARRUSEL
             ================================================================= -->
        <div id="sec-hero" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 1</span>
                <h2 class="sc-section-group-title mb-0">Hero y Carrusel de Portada</h2>
            </div>

            <!-- 1.1 Textos del Hero -->
            <section class="sc-panel-card" aria-labelledby="hero-config-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="hero-config-heading" class="sc-panel-card-title">1.1 Textos del Hero</h3>
                        <p class="sc-panel-card-subtitle mb-0">Título principal, texto destacado y subtítulo visibles sobre el carrusel.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(hero_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-7">
                            {{ form_label(hero_form.titlePrefix, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.titlePrefix) }}
                            {{ form_errors(hero_form.titlePrefix) }}
                        </div>

                        <div class="col-12 col-lg-5">
                            {{ form_label(hero_form.titleHighlight, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.titleHighlight) }}
                            {{ form_errors(hero_form.titleHighlight) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(hero_form.subtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(hero_form.subtitle) }}
                            {{ form_errors(hero_form.subtitle) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">
                                Guardar
                            </button>
                        </div>
                    {{ form_end(hero_form) }}
                </div>
            </section>

            <!-- 1.2 Carrusel de imágenes -->
            <section class="sc-panel-card" aria-labelledby="hero-slides-heading">
                <div class="sc-panel-card-header flex-wrap">
                    <div>
                        <h3 id="hero-slides-heading" class="sc-panel-card-title">1.2 Carrusel de imágenes</h3>
                        <p class="sc-panel-card-subtitle mb-0">
                            Si no hay diapositivas activas registradas aquí, se mostrarán las 4 imágenes predeterminadas de SoftCorec.
                        </p>
                    </div>
                    <button type="button" class="btn sc-btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewSlide">
                        + Nueva diapositiva
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Vista previa</th>
                                <th scope="col">Descripción (Alt)</th>
                                <th scope="col">Orden</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for slide in slides %}
                                <tr>
                                    <td>
                                        <img src="{{ slide.imagePath }}" alt="{{ slide.altText }}" class="sc-slide-thumb">
                                    </td>
                                    <td class="fw-medium text-dark">{{ slide.altText }}</td>
                                    <td>{{ slide.sortOrder }}</td>
                                    <td>
                                        <span class="sc-status-pill {{ slide.isActive ? 'is-online' : 'is-warning' }}">
                                            <span class="sc-status-dot" aria-hidden="true"></span>
                                            {{ slide.isActive ? 'Activa' : 'Oculta' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path('app_admin_home_slide_edit', { id: slide.id }) }}" class="btn sc-btn-outline btn-sm">
                                                Editar
                                            </a>
                                            <form method="post" action="{{ path('app_admin_home_slide_delete', { id: slide.id }) }}" onsubmit="return confirm('¿Eliminar esta diapositiva del carrusel?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_hero_slide_' ~ slide.id) }}">
                                                <button type="submit" class="btn sc-btn-danger-soft btn-sm">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Aún no hay diapositivas personalizadas. El sitio público está usando el carrusel predeterminado.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- =================================================================
             2. NUESTROS PILARES (SERVICIOS)
             ================================================================= -->
        <div id="sec-pilares" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 2</span>
                <h2 class="sc-section-group-title mb-0">Nuestros Pilares (Servicios)</h2>
            </div>

            <!-- 2.1 Encabezado de Pilares -->
            <section class="sc-panel-card" aria-labelledby="services-config-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="services-config-heading" class="sc-panel-card-title">2.1 Encabezado de Nuestros Pilares</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita la etiqueta superior, título y subtítulo de la sección de servicios.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(services_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(services_form.eyebrow, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(services_form.eyebrow) }}
                            {{ form_errors(services_form.eyebrow) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(services_form.title, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(services_form.title) }}
                            {{ form_errors(services_form.title) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(services_form.subtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(services_form.subtitle) }}
                            {{ form_errors(services_form.subtitle) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">
                                Guardar
                            </button>
                        </div>
                    {{ form_end(services_form) }}
                </div>
            </section>

            <!-- 2.2 Tarjetas de Servicios -->
            <section class="sc-panel-card" aria-labelledby="service-cards-heading">
                <div class="sc-panel-card-header flex-wrap">
                    <div>
                        <h3 id="service-cards-heading" class="sc-panel-card-title">2.2 Tarjetas de Servicios</h3>
                        <p class="sc-panel-card-subtitle mb-0">
                            Si no hay tarjetas activas registradas aquí, se mostrarán las 3 tarjetas predeterminadas de SoftCorec.
                        </p>
                    </div>
                    <button type="button" class="btn sc-btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewServiceCard">
                        + Nueva tarjeta
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Título</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Orden</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for card in service_cards %}
                                <tr>
                                    <td class="fw-semibold text-dark">{{ card.title }}</td>
                                    <td class="text-muted">{{ card.description|length > 90 ? card.description|slice(0, 90) ~ '…' : card.description }}</td>
                                    <td>{{ card.sortOrder }}</td>
                                    <td>
                                        <span class="sc-status-pill {{ card.isActive ? 'is-online' : 'is-warning' }}">
                                            <span class="sc-status-dot" aria-hidden="true"></span>
                                            {{ card.isActive ? 'Activa' : 'Oculta' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path('app_admin_home_service_edit', { id: card.id }) }}" class="btn sc-btn-outline btn-sm">
                                                Editar
                                            </a>
                                            <form method="post" action="{{ path('app_admin_home_service_delete', { id: card.id }) }}" onsubmit="return confirm('¿Eliminar esta tarjeta de servicio?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_service_card_' ~ card.id) }}">
                                                <button type="submit" class="btn sc-btn-danger-soft btn-sm">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Aún no hay tarjetas personalizadas. El sitio público está usando las 3 tarjetas predeterminadas.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- =================================================================
             3. CÓMO TRABAJAMOS (METODOLOGÍA)
             ================================================================= -->
        <div id="sec-metodologia" class="sc-section-group d-flex flex-column gap-4">
            <div class="sc-section-group-header">
                <span class="sc-section-badge">Sección 3</span>
                <h2 class="sc-section-group-title mb-0">Cómo Trabajamos (Metodología)</h2>
            </div>

            <!-- 3.1 Encabezado de Metodología -->
            <section class="sc-panel-card" aria-labelledby="methodology-config-heading">
                <div class="sc-panel-card-header">
                    <div>
                        <h3 id="methodology-config-heading" class="sc-panel-card-title">3.1 Encabezado de Cómo Trabajamos</h3>
                        <p class="sc-panel-card-subtitle mb-0">Edita la etiqueta superior, título y subtítulo de la sección de metodología.</p>
                    </div>
                </div>

                <div class="sc-panel-card-body">
                    {{ form_start(methodology_form, { attr: { class: 'row g-3' } }) }}
                        <div class="col-12 col-lg-4">
                            {{ form_label(methodology_form.eyebrow, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(methodology_form.eyebrow) }}
                            {{ form_errors(methodology_form.eyebrow) }}
                        </div>

                        <div class="col-12 col-lg-8">
                            {{ form_label(methodology_form.title, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(methodology_form.title) }}
                            {{ form_errors(methodology_form.title) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(methodology_form.subtitle, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(methodology_form.subtitle) }}
                            {{ form_errors(methodology_form.subtitle) }}
                        </div>

                        <div class="col-12 d-flex justify-content-center pt-2">
                            <button type="submit" class="btn sc-btn-primary">
                                Guardar
                            </button>
                        </div>
                    {{ form_end(methodology_form) }}
                </div>
            </section>

            <!-- 3.2 Pasos de Metodología -->
            <section class="sc-panel-card" aria-labelledby="methodology-steps-heading">
                <div class="sc-panel-card-header flex-wrap">
                    <div>
                        <h3 id="methodology-steps-heading" class="sc-panel-card-title">3.2 Pasos de Metodología</h3>
                        <p class="sc-panel-card-subtitle mb-0">
                            Si no hay pasos activos registrados aquí, se mostrarán los 4 pasos predeterminados de SoftCorec.
                        </p>
                    </div>
                    <button type="button" class="btn sc-btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalNewMethodologyStep">
                        + Nuevo paso
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table sc-admin-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Paso</th>
                                <th scope="col">Título</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for step in methodology_steps %}
                                <tr>
                                    <td><span class="sc-role-badge">{{ step.stepNumber }}</span></td>
                                    <td class="fw-semibold text-dark">{{ step.title }}</td>
                                    <td class="text-muted">{{ step.description|length > 90 ? step.description|slice(0, 90) ~ '…' : step.description }}</td>
                                    <td>
                                        <span class="sc-status-pill {{ step.isActive ? 'is-online' : 'is-warning' }}">
                                            <span class="sc-status-dot" aria-hidden="true"></span>
                                            {{ step.isActive ? 'Activo' : 'Oculto' }}
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a href="{{ path('app_admin_home_methodology_edit', { id: step.id }) }}" class="btn sc-btn-outline btn-sm">
                                                Editar
                                            </a>
                                            <form method="post" action="{{ path('app_admin_home_methodology_delete', { id: step.id }) }}" onsubmit="return confirm('¿Eliminar este paso de metodología?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_methodology_step_' ~ step.id) }}">
                                                <button type="submit" class="btn sc-btn-danger-soft btn-sm">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        Aún no hay pasos personalizados. El sitio público está usando los 4 pasos predeterminados.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <!-- Modal: Nueva Diapositiva -->
    <div class="modal fade sc-modal" id="modalNewSlide" tabindex="-1" aria-labelledby="modalNewSlideLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h3 class="modal-title sc-panel-card-title" id="modalNewSlideLabel">Nueva diapositiva</h3>
                        <p class="sc-panel-card-subtitle mb-0">Formatos admitidos: WebP, JPG o PNG (máx. 5 MB).</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                {{ form_start(new_slide_form) }}
                    <div class="modal-body row g-3">
                        <div class="col-12">
                            {{ form_label(new_slide_form.imageFile, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_slide_form.imageFile) }}
                            {{ form_errors(new_slide_form.imageFile) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(new_slide_form.altText, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_slide_form.altText) }}
                            {{ form_errors(new_slide_form.altText) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_slide_form.sortOrder, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_slide_form.sortOrder) }}
                            {{ form_errors(new_slide_form.sortOrder) }}
                        </div>
                        <div class="col-12 col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                {{ form_widget(new_slide_form.isActive) }}
                                {{ form_label(new_slide_form.isActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button type="button" class="btn sc-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn sc-btn-primary">Guardar</button>
                    </div>
                {{ form_end(new_slide_form) }}
            </div>
        </div>
    </div>

    <!-- Modal: Nueva Tarjeta de Servicio -->
    <div class="modal fade sc-modal" id="modalNewServiceCard" tabindex="-1" aria-labelledby="modalNewServiceCardLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h3 class="modal-title sc-panel-card-title" id="modalNewServiceCardLabel">Nueva tarjeta de servicio</h3>
                        <p class="sc-panel-card-subtitle mb-0">Se mostrará en la sección Nuestros Pilares de la portada.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                {{ form_start(new_service_card_form) }}
                    <div class="modal-body row g-3">
                        <div class="col-12 col-sm-5">
                            {{ form_label(new_service_card_form.iconKey, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.iconKey) }}
                            {{ form_errors(new_service_card_form.iconKey) }}
                        </div>
                        <div class="col-12 col-sm-7">
                            {{ form_label(new_service_card_form.title, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.title) }}
                            {{ form_errors(new_service_card_form.title) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(new_service_card_form.description, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.description) }}
                            {{ form_errors(new_service_card_form.description) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_service_card_form.linkText, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.linkText) }}
                            {{ form_errors(new_service_card_form.linkText) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_service_card_form.linkUrl, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.linkUrl) }}
                            {{ form_errors(new_service_card_form.linkUrl) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_service_card_form.sortOrder, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_service_card_form.sortOrder) }}
                            {{ form_errors(new_service_card_form.sortOrder) }}
                        </div>
                        <div class="col-12 col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                {{ form_widget(new_service_card_form.isActive) }}
                                {{ form_label(new_service_card_form.isActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button type="button" class="btn sc-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn sc-btn-primary">Guardar</button>
                    </div>
                {{ form_end(new_service_card_form) }}
            </div>
        </div>
    </div>

    <!-- Modal: Nuevo Paso de Metodología -->
    <div class="modal fade sc-modal" id="modalNewMethodologyStep" tabindex="-1" aria-labelledby="modalNewMethodologyStepLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h3 class="modal-title sc-panel-card-title" id="modalNewMethodologyStepLabel">Nuevo paso de metodología</h3>
                        <p class="sc-panel-card-subtitle mb-0">Se mostrará en la sección Cómo Trabajamos de la portada.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                {{ form_start(new_methodology_step_form) }}
                    <div class="modal-body row g-3">
                        <div class="col-12 col-sm-4">
                            {{ form_label(new_methodology_step_form.stepNumber, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_methodology_step_form.stepNumber) }}
                            {{ form_errors(new_methodology_step_form.stepNumber) }}
                        </div>
                        <div class="col-12 col-sm-8">
                            {{ form_label(new_methodology_step_form.title, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_methodology_step_form.title) }}
                            {{ form_errors(new_methodology_step_form.title) }}
                        </div>
                        <div class="col-12">
                            {{ form_label(new_methodology_step_form.description, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_methodology_step_form.description) }}
                            {{ form_errors(new_methodology_step_form.description) }}
                        </div>
                        <div class="col-12 col-sm-6">
                            {{ form_label(new_methodology_step_form.sortOrder, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                            {{ form_widget(new_methodology_step_form.sortOrder) }}
                            {{ form_errors(new_methodology_step_form.sortOrder) }}
                        </div>
                        <div class="col-12 col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                {{ form_widget(new_methodology_step_form.isActive) }}
                                {{ form_label(new_methodology_step_form.isActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button type="button" class="btn sc-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn sc-btn-primary">Guardar</button>
                    </div>
                {{ form_end(new_methodology_step_form) }}
            </div>
        </div>
    </div>
{% endblock %}
