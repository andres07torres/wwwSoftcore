{% extends 'admin/layout.html.twig' %}

{% block title %}Redes Sociales | Panel Administrativo SoftCorec{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block admin_content %}
    <div class="sc-page-header mb-4">
        <nav aria-label="Ruta de navegación" class="sc-breadcrumb">
            <a href="{{ path('app_admin_dashboard') }}">Dashboard</a>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span>Configuración</span>
            <span class="sc-breadcrumb-sep" aria-hidden="true">/</span>
            <span class="sc-breadcrumb-current" aria-current="page">Redes Sociales</span>
        </nav>
        <h1 class="sc-page-title mb-1">Redes Sociales</h1>
        <p class="sc-page-subtitle mb-0">Configura los enlaces visibles en la barra de navegación superior y en el pie de página de todo el sitio.</p>
    </div>

    <section class="sc-panel-card" style="max-width: 820px;">
        <div class="sc-panel-card-header">
            <div>
                <h2 class="sc-panel-card-title">Enlaces de redes sociales</h2>
                <p class="sc-panel-card-subtitle mb-0">Activa o desactiva cada red social y actualiza su enlace oficial.</p>
            </div>
        </div>
        <div class="sc-panel-card-body">
            {{ form_start(form, { attr: { class: 'd-flex flex-column gap-4' } }) }}
                <!-- WhatsApp -->
                <div class="row g-3 align-items-end pb-3 border-bottom">
                    <div class="col-12 col-md-8">
                        {{ form_label(form.whatsappUrl, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                        {{ form_widget(form.whatsappUrl) }}
                        {{ form_errors(form.whatsappUrl) }}
                    </div>
                    <div class="col-12 col-md-4 pb-2">
                        <div class="form-check form-switch">
                            {{ form_widget(form.whatsappActive) }}
                            {{ form_label(form.whatsappActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                        </div>
                    </div>
                </div>

                <!-- Instagram -->
                <div class="row g-3 align-items-end pb-3 border-bottom">
                    <div class="col-12 col-md-8">
                        {{ form_label(form.instagramUrl, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                        {{ form_widget(form.instagramUrl) }}
                        {{ form_errors(form.instagramUrl) }}
                    </div>
                    <div class="col-12 col-md-4 pb-2">
                        <div class="form-check form-switch">
                            {{ form_widget(form.instagramActive) }}
                            {{ form_label(form.instagramActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                        </div>
                    </div>
                </div>

                <!-- Facebook -->
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-8">
                        {{ form_label(form.facebookUrl, null, { label_attr: { class: 'form-label sc-form-label' } }) }}
                        {{ form_widget(form.facebookUrl) }}
                        {{ form_errors(form.facebookUrl) }}
                    </div>
                    <div class="col-12 col-md-4 pb-2">
                        <div class="form-check form-switch">
                            {{ form_widget(form.facebookActive) }}
                            {{ form_label(form.facebookActive, null, { label_attr: { class: 'form-check-label sc-form-label mb-0' } }) }}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center pt-2">
                    <button type="submit" class="btn sc-btn-primary">Guardar</button>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
