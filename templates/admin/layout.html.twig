{% extends 'admin/base_admin.html.twig' %}

{% block body %}
{% set current_route = app.request.attributes.get('_route') %}
<div class="sc-admin-layout">
    <!-- Sidebar Desktop / Offcanvas Mobile -->
    <aside class="sc-admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="Menú administrativo">
        <div class="sc-sidebar-header">
            <a href="{{ path('app_admin_dashboard') }}" class="sc-sidebar-brand">
                <img src="{{ asset('assets/images/softcore-logo.svg', 'vite') }}" alt="SoftCorec" height="54">
            </a>
            <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Cerrar menú"></button>
        </div>

        <nav class="sc-sidebar-nav" aria-label="Secciones del panel">
            <span class="sc-sidebar-section-label">Administración</span>
            <ul class="sc-sidebar-list">
                <li>
                    <a href="{{ path('app_admin_dashboard') }}" class="sc-sidebar-link {{ current_route == 'app_admin_dashboard' ? 'active' }}" {{ current_route == 'app_admin_dashboard' ? 'aria-current="page"' }}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                        </svg>
                        <span>Resumen general</span>
                    </a>
                </li>
            </ul>

            <span class="sc-sidebar-section-label mt-4">Gestión de Contenido</span>
            <ul class="sc-sidebar-list">
                <li>
                    <a href="{{ path('app_admin_home') }}" class="sc-sidebar-link {{ current_route starts with 'app_admin_home' ? 'active' }}" {{ current_route starts with 'app_admin_home' ? 'aria-current="page"' }}>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
                        </svg>
                        <span>Inicio</span>
                    </a>
                </li>
                <li><a href="{{ path('app_about') }}" class="sc-sidebar-link" target="_blank" rel="noopener noreferrer"><span>Quiénes Somos</span></a></li>
                <li><a href="{{ path('app_services') }}" class="sc-sidebar-link" target="_blank" rel="noopener noreferrer"><span>Servicios</span></a></li>
                <li><a href="{{ path('app_methodology') }}" class="sc-sidebar-link" target="_blank" rel="noopener noreferrer"><span>Metodología</span></a></li>
                <li><a href="{{ path('app_technology') }}" class="sc-sidebar-link" target="_blank" rel="noopener noreferrer"><span>Tecnologías</span></a></li>
            </ul>
        </nav>

        <div class="sc-sidebar-footer">
            <div class="sc-user-chip">
                <div class="sc-user-avatar" aria-hidden="true">
                    {{ app.user.fullName|slice(0, 1)|upper }}
                </div>
                <div class="sc-user-meta">
                    <div class="sc-user-name">{{ app.user.fullName }}</div>
                    <div class="sc-user-email">{{ app.user.email }}</div>
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="btn sc-btn-logout w-100 mt-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
                </svg>
                <span>Cerrar sesión</span>
            </a>
        </div>
    </aside>

    <!-- Main Area -->
    <div class="sc-admin-main">
        <header class="sc-admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button
                    class="btn sc-topbar-menu-btn d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#adminSidebar"
                    aria-controls="adminSidebar"
                    aria-expanded="false"
                    aria-label="Abrir menú administrativo"
                >
                    <span class="sc-hamburger" aria-hidden="true">
                        <span class="sc-hamburger-line"></span>
                        <span class="sc-hamburger-line"></span>
                        <span class="sc-hamburger-line"></span>
                    </span>
                </button>
                {% set _topbar_title %}{% block page_title %}Panel Administrativo{% endblock %}{% endset %}
                {% set _topbar_subtitle %}{% block page_subtitle %}{% endblock %}{% endset %}
                {% if _topbar_title|trim is not empty or _topbar_subtitle|trim is not empty %}
                    <div>
                        {% if _topbar_title|trim is not empty %}
                            <h1 class="sc-topbar-title mb-0">{{ _topbar_title|raw }}</h1>
                        {% endif %}
                        {% if _topbar_subtitle|trim is not empty %}
                            <p class="sc-topbar-subtitle mb-0">{{ _topbar_subtitle|raw }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="d-flex align-items-center gap-3">
                {% block topbar_actions %}{% endblock %}

                <!-- Reloj Hora Ecuador (America/Guayaquil) -->
                <span class="sc-topbar-clock" data-ecuador-clock aria-label="Hora de Ecuador">--:--</span>

                <!-- Notificaciones -->
                <div class="dropdown sc-notif-dropdown">
                    <button
                        type="button"
                        class="btn sc-notif-btn"
                        id="adminNotifToggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Notificaciones"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                        </svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end sc-notif-menu" aria-labelledby="adminNotifToggle">
                        <div class="sc-notif-header">
                            <span class="sc-notif-title">Notificaciones</span>
                            <span class="sc-notif-count">Al día</span>
                        </div>
                        <div class="sc-notif-empty">
                            <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="sc-notif-empty-icon" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                            </svg>
                            <p class="mb-0">No tienes notificaciones pendientes</p>
                        </div>
                    </div>
                </div>

                <!-- Menú de Usuario -->
                <div class="dropdown sc-user-dropdown">
                    <button
                        type="button"
                        class="btn sc-user-menu-btn"
                        id="adminUserToggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Menú de usuario"
                    >
                        {% if app.user.avatarPath %}
                            <img src="{{ app.user.avatarPath }}" alt="{{ app.user.fullName }}" class="sc-user-btn-avatar">
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 003.065 7.097A9.716 9.716 0 0012 21.75a9.716 9.716 0 006.685-2.653zm-12.54-1.285A7.486 7.486 0 0112 15a7.486 7.486 0 015.855 2.812A8.224 8.224 0 0112 20.25a8.224 8.224 0 01-5.855-2.438zM15.75 9a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" clip-rule="evenodd"/>
                            </svg>
                        {% endif %}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end sc-user-menu" aria-labelledby="adminUserToggle">
                        <div class="sc-user-menu-header">
                            <div class="sc-user-menu-avatar">
                                {% if app.user.avatarPath %}
                                    <img src="{{ app.user.avatarPath }}" alt="{{ app.user.fullName }}">
                                {% else %}
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </div>
                            <div class="sc-user-meta">
                                <div class="sc-user-menu-name">{{ app.user.fullName }}</div>
                                <div class="sc-user-menu-email">{{ app.user.email }}</div>
                            </div>
                        </div>
                        <div class="sc-user-menu-body">
                            <a href="{{ path('app_admin_profile') }}" class="dropdown-item sc-user-menu-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                                </svg>
                                <span>Gestionar mi perfil</span>
                            </a>
                            <a href="{{ path('app_admin_profile') }}#foto" class="dropdown-item sc-user-menu-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z"/>
                                </svg>
                                <span>Cambiar foto de perfil</span>
                            </a>
                            <a href="{{ path('app_admin_profile') }}#contrasena" class="dropdown-item sc-user-menu-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                                </svg>
                                <span>Cambiar contraseña</span>
                            </a>
                        </div>
                        <div class="sc-user-menu-footer">
                            <a href="{{ path('app_logout') }}" class="dropdown-item sc-user-menu-item is-danger">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9"/>
                                </svg>
                                <span>Cerrar Sesión</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="sc-admin-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} sc-admin-alert mb-4" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </main>
    </div>
</div>
{% endblock %}
