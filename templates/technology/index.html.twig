                            <div>
                                <h3 class="h6 fw-bold text-navy mb-1" data-i18n="technology_page.cat_mobile_title">Desarrollo Móvil (Android & iOS)</h3>
                                <div class="extra-small text-muted" data-i18n="technology_page.cat_mobile_sub">Aplicaciones nativas de alto rendimiento y arquitectura moderna</div>
                            </div>
                        </div>
                        <p class="text-muted extra-small mb-3" data-i18n="technology_page.cat_mobile_desc">
