                            <span class="tech-tag-item">Coroutines / Flow</span>
                            <span class="tech-tag-item">Swift (iOS)</span>
                            <span class="tech-tag-item">Flutter</span>
                        </div>
                    </div>
                </div>

                <!-- 4. Cloud & DevOps -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="tech-matrix-card card h-100 p-4 border-0 shadow-sm rounded-4">
