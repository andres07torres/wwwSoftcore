<!-- =========================================================================
     4. ESTÁNDARES Y PATRONES DE INGENIERÍA
     ========================================================================= -->
<section class="technology-standards-section py-5 py-lg-6 bg-light" id="estandares" aria-labelledby="standards-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            {% if cfg %}
                <span class="section-eyebrow">{{ cfg.practicesEyebrow }}</span>
                <h2 id="standards-title" class="section-title">{{ cfg.practicesTitle }}</h2>
                <p class="section-subtitle text-muted">{{ cfg.practicesSubtitle }}</p>
            {% else %}
                <span class="section-eyebrow" data-i18n="technology_page.std_eyebrow">Buenas Prácticas</span>
                <h2 id="standards-title" class="section-title" data-i18n="technology_page.std_title">Estándares de ingeniería aplicados a cada entrega</h2>
                <p class="section-subtitle text-muted" data-i18n="technology_page.std_subtitle">
                    La tecnología cobra valor cuando está respaldada por patrones de diseño probados y procesos continuos de aseguramiento de calidad.
                </p>
            {% endif %}
        </div>

        <div class="row g-4">
            {% if tech_practices|default([]) is not empty %}
                {% for practice in tech_practices %}
                    <div class="col-12 col-md-4">
                        <div class="standard-card card h-100 p-4 border-0 shadow-sm rounded-4 bg-white">
                            <div class="standard-number font-monospace text-primary fw-bold mb-3">{{ practice.stepNumber }}</div>
                            <h3 class="h6 fw-bold text-navy mb-2">{{ practice.title }}</h3>
                            <p class="text-muted extra-small mb-0">{{ practice.description }}</p>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 col-md-4">
                    <div class="standard-card card h-100 p-4 border-0 shadow-sm rounded-4 bg-white">
                        <div class="standard-number font-monospace text-primary fw-bold mb-3">01</div>
                        <h3 class="h6 fw-bold text-navy mb-2" data-i18n="technology_page.std1_title">Arquitectura Hexagonal & DDD</h3>
                        <p class="text-muted extra-small mb-0" data-i18n="technology_page.std1_desc">
                            Aislamiento estricto de la lógica de negocio frente a frameworks y bases de datos, facilitando tests automatizados y mantenimiento a largo plazo.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="standard-card card h-100 p-4 border-0 shadow-sm rounded-4 bg-white">
                        <div class="standard-number font-monospace text-primary fw-bold mb-3">02</div>
                        <h3 class="h6 fw-bold text-navy mb-2" data-i18n="technology_page.std2_title">API-First & Contratos Claros</h3>
                        <p class="text-muted extra-small mb-0" data-i18n="technology_page.std2_desc">
                            Definición formal de interfaces con OpenAPI 3.0 / Swagger antes del desarrollo, habilitando integración paralela fluida entre frontend y backend.
                        </p>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="standard-card card h-100 p-4 border-0 shadow-sm rounded-4 bg-white">
                        <div class="standard-number font-monospace text-primary fw-bold mb-3">03</div>
                        <h3 class="h6 fw-bold text-navy mb-2" data-i18n="technology_page.std3_title">Observabilidad & Telemetría</h3>
                        <p class="text-muted extra-small mb-0" data-i18n="technology_page.std3_desc">
                            Monitoreo integral de métricas, trazas distribuidas y logs centralizados para detectar anomalías antes de que afecten la experiencia del usuario.
                        </p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
