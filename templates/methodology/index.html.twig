{% extends 'base.html.twig' %}

{% block title %}Metodología - SoftCorec | Proceso Ágil, Arquitectura & Entregas Continuas{% endblock %}
{% block meta_description %}Descubre la metodología ágil de SoftCorec: descubrimiento técnico, diseño arquitectónico, entregas continuas y aseguramiento de calidad.{% endblock %}

{% block body %}
<!-- =========================================================================
     1. HERO SECTION - METODOLOGÍA
     ========================================================================= -->
<section class="methodology-hero-section position-relative text-white" aria-labelledby="methodology-hero-title">
    <div class="methodology-hero-bg-overlay"></div>
    <div class="container position-relative py-0 py-lg-4">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-12 col-lg-7">
                <h1 id="methodology-hero-title" class="methodology-hero-title mb-4" data-i18n-html="methodology_page.hero_title">
                    Metodología diseñada para <span class="text-gradient-light">entregas continuas</span> y valor medible
                </h1>

                <p class="methodology-hero-subtitle text-white-50 mb-4 lead" data-i18n="methodology_page.hero_subtitle">
                    Combinamos rigor de arquitectura, sprints iterativos y automatización CI/CD para convertir requerimientos complejos en software robusto, escalable y sin fricción operativa.
                </p>

                <div class="methodology-hero-actions d-flex flex-wrap align-items-center gap-3 justify-content-center justify-content-lg-start mx-auto mx-lg-0">
                    <a href="{{ path('app_services') }}#formulario-contacto" class="btn btn-hero-primary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="methodology_page.hero_btn_cta">Iniciar Proyecto</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                    <a href="#fases" class="btn btn-hero-outline-light btn-hero-secondary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="methodology_page.hero_btn_phases">Explorar las Fases</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </a>
                </div>

                <div class="text-white-50 extra-small pt-3 mt-1" data-i18n="methodology_page.hero_flow_note">
                    Ciclos de 2 semanas · Demostraciones en staging · Transparencia radical
                </div>
            </div>

            <!-- Panel de Pipeline de Entrega Continua (diferenciador visual de metodología en desktop) -->
            <div class="col-12 col-lg-5 d-none d-lg-block">
                <div class="methodology-hero-console card border border-white-15 rounded-4 shadow-lg overflow-hidden bg-glass text-white">
                    <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom border-white-10 bg-black-20">
                        <div class="d-flex align-items-center gap-2">
                            <span class="console-circle console-circle-red"></span>
                            <span class="console-circle console-circle-yellow"></span>
                            <span class="console-circle console-circle-green"></span>
                            <span class="extra-small font-monospace text-white-50 ms-1">pipeline: agile-lifecycle.yaml</span>
                        </div>
                        <span class="extra-small font-monospace text-info">active</span>
                    </div>
                    
                    <div class="p-3 p-lg-4">
                        <div class="pipeline-step-row d-flex align-items-start gap-3 pb-2 mb-2 border-bottom border-white-10">
                            <span class="font-monospace text-info extra-small fw-bold">01</span>
                            <div>
                                <div class="extra-small fw-semibold text-white" data-i18n="methodology_page.pipe1_title">Descubrimiento & Estrategia</div>
                                <div class="extra-small text-white-50" data-i18n="methodology_page.pipe1_desc">SAD, contratos y backlog priorizado</div>
                            </div>
                        </div>
                        <div class="pipeline-step-row d-flex align-items-start gap-3 pb-2 mb-2 border-bottom border-white-10">
                            <span class="font-monospace text-info extra-small fw-bold">02</span>
                            <div>
                                <div class="extra-small fw-semibold text-white" data-i18n="methodology_page.pipe2_title">Arquitectura & Diseño C4</div>
                                <div class="extra-small text-white-50" data-i18n="methodology_page.pipe2_desc">OpenAPI, esquemas BD e infraestructura base</div>
                            </div>
                        </div>
                        <div class="pipeline-step-row d-flex align-items-start gap-3 pb-2 mb-2 border-bottom border-white-10">
                            <span class="font-monospace text-info extra-small fw-bold">03</span>
                            <div>
                                <div class="extra-small fw-semibold text-white" data-i18n="methodology_page.pipe3_title">Sprints Ágiles Iterativos</div>
                                <div class="extra-small text-white-50" data-i18n="methodology_page.pipe3_desc">Entregas quincenales funcionales en staging</div>
                            </div>
                        </div>
                        <div class="pipeline-step-row d-flex align-items-start gap-3 pb-2 mb-2 border-bottom border-white-10">
                            <span class="font-monospace text-info extra-small fw-bold">04</span>
                            <div>
                                <div class="extra-small fw-semibold text-white" data-i18n="methodology_page.pipe4_title">QA & Hardening OWASP</div>
                                <div class="extra-small text-white-50" data-i18n="methodology_page.pipe4_desc">Tests automatizados de carga y seguridad</div>
                            </div>
                        </div>
                        <div class="pipeline-step-row d-flex align-items-start gap-3">
                            <span class="font-monospace text-info extra-small fw-bold">05</span>
                            <div>
                                <div class="extra-small fw-semibold text-white" data-i18n="methodology_page.pipe5_title">Despliegue Continuo Cloud</div>
                                <div class="extra-small text-white-50" data-i18n="methodology_page.pipe5_desc">Zero-downtime, telemetría y soporte 24/7</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. PILARES FUNDAMENTALES DE NUESTRO PROCESO
     ========================================================================= -->
<section class="methodology-pillars-section py-5 py-lg-6 bg-light" id="pilares" aria-labelledby="pillars-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="methodology_page.pillars_eyebrow">Nuestra Filosofía</span>
            <h2 id="pillars-title" class="section-title" data-i18n="methodology_page.pillars_title">Principios que garantizan predictibilidad y calidad</h2>
            <p class="section-subtitle text-muted" data-i18n="methodology_page.pillars_subtitle">
                Estructuramos cada desarrollo para reducir la incertidumbre, acelerar el time-to-market y proteger la estabilidad de tus operaciones.
            </p>
        </div>

        <div class="row g-4">
            <!-- Pilar 1 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="pillar-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="pillar-icon-box mb-3">
                        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                        </svg>
                    </div>
                    <h3 class="h5 pillar-title mb-2" data-i18n="methodology_page.p1_title">Architecture-First</h3>
                    <p class="text-muted small mb-0" data-i18n="methodology_page.p1_desc">
                        Definición formal de contratos API, esquemas de persistencia y patrones limpios antes de escribir una sola línea de código funcional.
                    </p>
                </div>
            </div>

            <!-- Pilar 2 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="pillar-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="pillar-icon-box mb-3">
                        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <h3 class="h5 pillar-title mb-2" data-i18n="methodology_page.p2_title">Sprints Iterativos</h3>
                    <p class="text-muted small mb-0" data-i18n="methodology_page.p2_desc">
                        Ciclos de entrega de 2 semanas con demostraciones funcionales continuas. Cero cajas negras y visibilidad total del avance.
                    </p>
                </div>
            </div>

            <!-- Pilar 3 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="pillar-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="pillar-icon-box mb-3">
                        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <h3 class="h5 pillar-title mb-2" data-i18n="methodology_page.p3_title">QA & CI/CD Automatizado</h3>
                    <p class="text-muted small mb-0" data-i18n="methodology_page.p3_desc">
                        Cada pull request pasa por un pipeline estricto de pruebas unitarias, análisis estático y escaneo de vulnerabilidades.
                    </p>
                </div>
            </div>

            <!-- Pilar 4 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="pillar-card card h-100 p-4 border-0 shadow-sm rounded-4">
                    <div class="pillar-icon-box mb-3">
                        <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </div>
                    <h3 class="h5 pillar-title mb-2" data-i18n="methodology_page.p4_title">Transparencia Radical</h3>
                    <p class="text-muted small mb-0" data-i18n="methodology_page.p4_desc">
                        Tableros de gestión compartidos, estimaciones realistas y acceso directo al equipo de ingeniería sin intermediarios.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. LAS 5 FASES DEL CICLO DE VIDA DEL SOFTWARE
     ========================================================================= -->
<section class="methodology-phases-section py-5 py-lg-6 bg-white" id="fases" aria-labelledby="phases-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="methodology_page.phases_eyebrow">Ciclo de Entrega</span>
            <h2 id="phases-title" class="section-title" data-i18n="methodology_page.phases_title">De la idea a la producción en 5 etapas</h2>
            <p class="section-subtitle text-muted" data-i18n="methodology_page.phases_subtitle">
                Un flujo estructurado donde cada fase cuenta con objetivos claros y entregables técnicos verificables.
            </p>
        </div>

        <div class="phases-timeline">
            <!-- Fase 1 -->
            <div class="phase-item card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-3 text-start text-md-center">
                        <div class="d-inline-flex flex-column align-items-start align-items-md-center">
                            <span class="phase-step-badge mb-1">FASE 01</span>
                            <span class="phase-duration text-muted extra-small" data-i18n="methodology_page.f1_dur">Semana 1 - 2</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-9">
                        <h3 class="h4 phase-title mb-2" data-i18n="methodology_page.f1_title">Descubrimiento & Diagnóstico Estratégico</h3>
                        <p class="text-muted mb-3" data-i18n="methodology_page.f1_desc">
                            Iniciamos con una inmersión profunda en tu modelo de negocio, requerimientos funcionales y sistemas existentes. Evaluamos riesgos técnicos, dependencias e identificamos oportunidades de optimización.
                        </p>
                        <div class="phase-deliverable d-flex flex-wrap align-items-baseline gap-2 pt-1">
                            <span class="fw-bold text-navy small" data-i18n="methodology_page.deliverable_lbl">Entregable:</span>
                            <span class="text-muted small" data-i18n="methodology_page.f1_deliv">Documento de Arquitectura de Solución (SAD) y backlog priorizado</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fase 2 -->
            <div class="phase-item card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-3 text-start text-md-center">
                        <div class="d-inline-flex flex-column align-items-start align-items-md-center">
                            <span class="phase-step-badge mb-1">FASE 02</span>
                            <span class="phase-duration text-muted extra-small" data-i18n="methodology_page.f2_dur">Semana 2 - 3</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-9">
                        <h3 class="h4 phase-title mb-2" data-i18n="methodology_page.f2_title">Arquitectura & Diseño de Solución</h3>
                        <p class="text-muted mb-3" data-i18n="methodology_page.f2_desc">
                            Modelamos las entidades de datos, especificamos contratos de API (OpenAPI/Swagger), diseñamos los flujos de usuario y configuramos la infraestructura base en la nube mediante código (Terraform).
                        </p>
                        <div class="phase-deliverable d-flex flex-wrap align-items-baseline gap-2 pt-1">
                            <span class="fw-bold text-navy small" data-i18n="methodology_page.deliverable_lbl">Entregable:</span>
                            <span class="text-muted small" data-i18n="methodology_page.f2_deliv">Diagramas de arquitectura C4, esquemas de BD y prototipos de interfaz</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fase 3 -->
            <div class="phase-item card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-3 text-start text-md-center">
                        <div class="d-inline-flex flex-column align-items-start align-items-md-center">
                            <span class="phase-step-badge mb-1">FASE 03</span>
                            <span class="phase-duration text-muted extra-small" data-i18n="methodology_page.f3_dur">Sprints quincenales</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-9">
                        <h3 class="h4 phase-title mb-2" data-i18n="methodology_page.f3_title">Desarrollo Iterativo & Sprints Ágiles</h3>
                        <p class="text-muted mb-3" data-i18n="methodology_page.f3_desc">
                            Desarrollamos en sprints de dos semanas bajo metodologías ágiles. Cada sprint culmina con una sesión de demostración del software funcionando en un entorno de staging para recibir retroalimentación temprana.
                        </p>
                        <div class="phase-deliverable d-flex flex-wrap align-items-baseline gap-2 pt-1">
                            <span class="fw-bold text-navy small" data-i18n="methodology_page.deliverable_lbl">Entregable:</span>
                            <span class="text-muted small" data-i18n="methodology_page.f3_deliv">Incrementos de software funcionales desplegados en staging para revisión</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fase 4 -->
            <div class="phase-item card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-4">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-3 text-start text-md-center">
                        <div class="d-inline-flex flex-column align-items-start align-items-md-center">
                            <span class="phase-step-badge mb-1">FASE 04</span>
                            <span class="phase-duration text-muted extra-small" data-i18n="methodology_page.f4_dur">Fase de validación</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-9">
                        <h3 class="h4 phase-title mb-2" data-i18n="methodology_page.f4_title">Aseguramiento de Calidad & Hardening de Seguridad</h3>
                        <p class="text-muted mb-3" data-i18n="methodology_page.f4_desc">
                            Pruebas exhaustivas de carga y estrés, verificación de seguridad OWASP, validación de compatibilidad multidispositivo y pruebas de aceptación de usuario (UAT) para asegurar máxima estabilidad.
                        </p>
                        <div class="phase-deliverable d-flex flex-wrap align-items-baseline gap-2 pt-1">
                            <span class="fw-bold text-navy small" data-i18n="methodology_page.deliverable_lbl">Entregable:</span>
                            <span class="text-muted small" data-i18n="methodology_page.f4_deliv">Reporte de QA, matriz de pruebas de seguridad y certificación para salida</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fase 5 -->
            <div class="phase-item card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-md-3 text-start text-md-center">
                        <div class="d-inline-flex flex-column align-items-start align-items-md-center">
                            <span class="phase-step-badge mb-1">FASE 05</span>
                            <span class="phase-duration text-muted extra-small" data-i18n="methodology_page.f5_dur">Continuo</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-9">
                        <h3 class="h4 phase-title mb-2" data-i18n="methodology_page.f5_title">Despliegue Automatizado & Operación Cloud</h3>
                        <p class="text-muted mb-3" data-i18n="methodology_page.f5_desc">
                            Pase a producción automatizado mediante estrategias Blue/Green o Canary (sin tiempo de inactividad). Activación de alertas de monitoreo 24/7 y acompañamiento técnico post-lanzamiento.
                        </p>
                        <div class="phase-deliverable d-flex flex-wrap align-items-baseline gap-2 pt-1">
                            <span class="fw-bold text-navy small" data-i18n="methodology_page.deliverable_lbl">Entregable:</span>
                            <span class="text-muted small" data-i18n="methodology_page.f5_deliv">Sistema en producción, dashboards de observabilidad y soporte continuo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. ESTÁNDARES Y RIGOR DE INGENIERÍA
     ========================================================================= -->
<section class="methodology-standards-section py-5 py-lg-6 bg-light" aria-labelledby="standards-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="methodology_page.standards_eyebrow">Buenas Prácticas</span>
            <h2 id="standards-title" class="section-title" data-i18n="methodology_page.standards_title">Estándares técnicos no negociables</h2>
            <p class="section-subtitle text-muted" data-i18n="methodology_page.standards_subtitle">
                Nuestro código y nuestras arquitecturas están respaldados por convenciones internacionales de la industria.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="standard-box p-4 rounded-4 bg-white shadow-sm h-100 text-center">
                    <div class="standard-icon mb-3 mx-auto">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold mb-2" data-i18n="methodology_page.s1_title">Clean Code & SOLID</h3>
                    <p class="text-muted extra-small mb-0" data-i18n="methodology_page.s1_desc">
                        Arquitecturas limpias y código desacoplado que facilitan el mantenimiento a largo plazo y la incorporación de nuevos desarrolladores.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="standard-box p-4 rounded-4 bg-white shadow-sm h-100 text-center">
                    <div class="standard-icon mb-3 mx-auto">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold mb-2" data-i18n="methodology_page.s2_title">CI/CD & GitFlow</h3>
                    <p class="text-muted extra-small mb-0" data-i18n="methodology_page.s2_desc">
                        Estrategia estricta de ramas, pull requests revisados por al menos dos ingenieros sénior y despliegues automáticos certificados.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="standard-box p-4 rounded-4 bg-white shadow-sm h-100 text-center">
                    <div class="standard-icon mb-3 mx-auto">
                        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold mb-2" data-i18n="methodology_page.s3_title">Seguridad por Diseño</h3>
                    <p class="text-muted extra-small mb-0" data-i18n="methodology_page.s3_desc">
                        Escaneo continuo de dependencias, protección contra inyecciones y cumplimiento de las 10 directrices clave de OWASP.
                    </p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="standard-box p-4 rounded-4 bg-white shadow-sm h-100 text-center">
