{% extends 'admin/base_admin.html.twig' %}

{% block title %}Iniciar sesión | Panel Administrativo SoftCorec{% endblock %}
{% block body_class %}sc-login-body{% endblock %}

{% block body %}
<div class="sc-login-wrapper">
    <main class="sc-login-card" aria-labelledby="login-heading">
        <div class="sc-login-accent-bar" aria-hidden="true"></div>

        <div class="sc-login-header">
            <a href="{{ path('app_home') }}" class="sc-login-brand" aria-label="Ir al inicio de SoftCorec">
                <img src="{{ asset('assets/images/softcore-logo.svg', 'vite') }}" alt="SoftCorec" height="46">
            </a>
            <span class="sc-login-badge">Panel Administrativo</span>
            <h1 id="login-heading" class="sc-login-title">Iniciar sesión</h1>
            <p class="sc-login-subtitle">Ingresa tus credenciales para acceder a la consola de administración.</p>
        </div>

        {% if error %}
            <div class="alert alert-danger sc-login-alert d-flex align-items-start gap-2" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="flex-shrink-0 mt-1" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                </svg>
                {% if error.messageKey starts with 'Too many failed login attempts' %}
                    {% set retry_minutes = error.messageData['%minutes%'] ?? 15 %}
                    <span>Demasiados intentos fallidos de inicio de sesión. Inténtalo de nuevo en {{ retry_minutes }} {{ retry_minutes == 1 ? 'minuto' : 'minutos' }}.</span>
                {% else %}
                    <span>Credenciales inválidas. Verifica tu correo electrónico y contraseña.</span>
                {% endif %}
            </div>
        {% endif %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} sc-login-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}" class="sc-login-form" novalidate>
            <div class="mb-3">
                <label for="inputEmail" class="form-label sc-form-label">Correo electrónico</label>
                <input
                    type="email"
                    value="{{ last_username }}"
                    name="_username"
                    id="inputEmail"
                    class="form-control sc-form-control"
                    placeholder="admin@softcorec.com"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div class="mb-4">
                <label for="inputPassword" class="form-label sc-form-label">Contraseña</label>
                <div class="input-group sc-password-group">
                    <input
                        type="password"
                        name="_password"
                        id="inputPassword"
                        class="form-control sc-form-control"
                        placeholder="Ingresa tu contraseña"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        type="button"
                        class="btn sc-password-toggle"
                        data-toggle-password="#inputPassword"
                        aria-label="Mostrar contraseña"
                        title="Mostrar contraseña"
                        aria-pressed="false"
                    >
                        <svg class="sc-icon-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        <svg class="sc-icon-eye-off" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"/>
                        </svg>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn sc-btn-primary w-100">
                Ingresar al panel
            </button>
        </form>

        <div class="sc-login-footer">
            <a href="{{ path('app_home') }}" class="sc-back-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
                </svg>
                <span>Volver al sitio principal</span>
            </a>
        </div>
    </main>
</div>
{% endblock %}
