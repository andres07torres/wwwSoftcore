{% extends 'base.html.twig' %}

{% block title %}Quiénes Somos - SoftCore | Arquitectura & Ingeniería de Software{% endblock %}

{% block body %}
<!-- =========================================================================
     1. HERO SECTION - QUIÉNES SOMOS
     ========================================================================= -->
<section class="about-hero-section position-relative text-white" aria-labelledby="about-hero-title">
    <div class="about-hero-bg-overlay"></div>
    <div class="container position-relative py-0 py-lg-4">
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-12 col-lg-7">
                <h1 id="about-hero-title" class="about-hero-title mb-4" data-i18n-html="about.hero_title">
                    Construyendo el futuro digital con <span class="text-gradient-light">ingeniería de software</span> de clase mundial
                </h1>

                <div class="about-hero-manifesto border-start border-2 border-info ps-3 ps-md-4 mb-4">
                    <p class="about-hero-subtitle text-white-75 mb-0 lead fs-6" data-i18n="about.hero_subtitle">
                        Somos una compañía de tecnología especializada en arquitectura de software distribuido, soluciones cloud-native y modernización de plataformas críticas para empresas que buscan escalar sin fricciones.
                    </p>
                </div>

                <div class="about-hero-actions d-flex flex-wrap gap-3 mb-4 justify-content-center justify-content-lg-start mx-auto mx-lg-0">
                    <a href="{{ path('app_home') }}#metodologia" class="btn btn-hero-primary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="about.hero_btn_cta">Trabajemos Juntos</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                    </a>
                    <a href="#valores" class="btn btn-hero-outline-light btn-hero-secondary rounded-pill d-inline-flex align-items-center gap-2">
                        <span data-i18n="about.hero_btn_values">Conoce Nuestra Cultura</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </a>
                </div>

                <!-- Barra integrada de trayectoria y métricas clave (visible en tablet y desktop) -->
                <div class="about-hero-stats d-none d-md-flex row g-3 pt-2">
                    <div class="col-4">
                        <div class="h4 fw-bold text-white mb-0">+7</div>
                        <div class="extra-small text-white-50" data-i18n="about.hero_stat1">Años de Trayectoria</div>
                    </div>
                    <div class="col-4">
                        <div class="h4 fw-bold text-white mb-0">+50</div>
                        <div class="extra-small text-white-50" data-i18n="about.hero_stat2">Sistemas Desplegados</div>
                    </div>
                    <div class="col-4">
                        <div class="h4 fw-bold text-white mb-0">99.98%</div>
                        <div class="extra-small text-white-50" data-i18n="about.hero_stat3">Uptime Promedio</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5 d-none d-lg-block">
                <div class="about-hero-media about-hero-card position-relative">
                    <!-- Imagen Principal con marco redondeado e iluminación glass -->
                    <div class="about-img-frame rounded-4 overflow-hidden shadow-lg border border-white-15">
                        <img src="{{ asset('assets/images/hero/hero-2.png', 'vite') }}" 
                             alt="Equipo de ingeniería de software y arquitectura cloud de SoftCore" 
                             class="img-fluid w-100 about-hero-img"
                             loading="eager">
                        <div class="about-img-overlay"></div>
                    </div>
                    <div class="about-hero-caption text-white-50 extra-small pt-2 text-center text-lg-end" data-i18n="about.hero_caption">
                        Ingeniería de Software & Arquitectura Cloud · SoftCore
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     2. PROPÓSITO: MISIÓN & VISIÓN EMPRESARIAL
     ========================================================================= -->
<section class="purpose-section py-5 py-lg-6 bg-light" id="proposito" aria-labelledby="purpose-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="about.purpose_eyebrow">Nuestro Propósito</span>
            <h2 id="purpose-title" class="section-title" data-i18n="about.purpose_title">Guiados por una visión de impacto tecnológico medible</h2>
            <p class="section-subtitle text-muted" data-i18n="about.purpose_subtitle">
                Alineamos la ingeniería informática avanzada con las metas comerciales estratégicas de cada cliente.
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Misión -->
            <div class="col-12 col-md-6 col-lg-5">
                <div class="purpose-card card h-100 p-4 p-lg-5 border-0 shadow-sm rounded-4 bg-white">
                    <div class="purpose-icon-wrap mb-4 bg-navy-light text-navy">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <span class="badge bg-light text-navy fw-semibold px-3 py-2 rounded-pill mb-3 align-self-start" data-i18n="about.mission_badge">Nuestra Misión</span>
                    <h3 class="h4 mb-3 text-navy fw-bold" data-i18n="about.mission_title">Potenciar el crecimiento con software de alto impacto</h3>
                    <p class="text-muted mb-0 lead-sm" data-i18n="about.mission_desc">
                        Empoderar a empresas e instituciones transformando desafíos operativos y de negocio en arquitecturas de software robustas, resilientes y eficientes, entregando valor tangible en cada despliegue.
                    </p>
                </div>
            </div>

            <!-- Visión -->
            <div class="col-12 col-md-6 col-lg-5">
                <div class="purpose-card card h-100 p-4 p-lg-5 border-0 shadow-sm rounded-4 bg-white">
                    <div class="purpose-icon-wrap mb-4 bg-primary-subtle text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </div>
                    <span class="badge bg-light text-primary fw-semibold px-3 py-2 rounded-pill mb-3 align-self-start" data-i18n="about.vision_badge">Nuestra Visión</span>
                    <h3 class="h4 mb-3 text-navy fw-bold" data-i18n="about.vision_title">Ser el socio tecnológico de referencia regional</h3>
                    <p class="text-muted mb-0 lead-sm" data-i18n="about.vision_desc">
                        Consolidarnos como el referente en arquitectura de software, DevOps y computación en la nube, reconocidos internacionalmente por nuestra rigurosidad técnica, capacidad de innovación y relaciones de confianza duraderas.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. VALORES & CULTURA DE INGENIERÍA
     ========================================================================= -->
<section class="values-section py-5 py-lg-6 bg-white" id="valores" aria-labelledby="values-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="about.values_eyebrow">Cultura & Principios</span>
            <h2 id="values-title" class="section-title" data-i18n="about.values_title">Los pilares que guían cada línea de código</h2>
            <p class="section-subtitle text-muted" data-i18n="about.values_subtitle">
                Nuestra cultura se fundamenta en principios sólidos de ingeniería, ética profesional y excelencia operativa.
            </p>
        </div>

        <div class="row g-4">
            <!-- Valor 1 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="value-card card h-100 p-4 border-0 shadow-sm rounded-4 text-center text-md-start">
                    <div class="value-icon-box mb-3 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                    </div>
                    <h3 class="h5 mb-2 text-navy" data-i18n="about.val1_title">Excelencia Técnica</h3>
                    <p class="text-muted small mb-0" data-i18n="about.val1_desc">
                        Diseñamos con patrones limpios, testing automatizado y arquitecturas sólidas. No tomamos atajos que comprometan la seguridad o mantenibilidad futura.
                    </p>
                </div>
            </div>

            <!-- Valor 2 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="value-card card h-100 p-4 border-0 shadow-sm rounded-4 text-center text-md-start">
                    <div class="value-icon-box mb-3 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h3 class="h5 mb-2 text-navy" data-i18n="about.val2_title">Orientación a Negocio</h3>
                    <p class="text-muted small mb-0" data-i18n="about.val2_desc">
                        La tecnología es una palanca para generar resultados. Priorizamos funcionalidades y decisiones que maximicen el retorno de inversión y la eficiencia operativa.
                    </p>
                </div>
            </div>

            <!-- Valor 3 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="value-card card h-100 p-4 border-0 shadow-sm rounded-4 text-center text-md-start">
                    <div class="value-icon-box mb-3 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                    </div>
                    <h3 class="h5 mb-2 text-navy" data-i18n="about.val3_title">Transparencia Radical</h3>
                    <p class="text-muted small mb-0" data-i18n="about.val3_desc">
                        Comunicación clara, estimaciones realistas y visibilidad total del estado de cada proyecto en sprints demostrables y sin cajas negras.
                    </p>
                </div>
            </div>

            <!-- Valor 4 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="value-card card h-100 p-4 border-0 shadow-sm rounded-4 text-center text-md-start">
                    <div class="value-icon-box mb-3 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                        </svg>
                    </div>
                    <h3 class="h5 mb-2 text-navy" data-i18n="about.val4_title">Innovación Pragmática</h3>
                    <p class="text-muted small mb-0" data-i18n="about.val4_desc">
                        Adoptamos las herramientas más modernas (Cloud, Microservicios, DevOps, IA) solo cuando aportan ventajas comprobadas sobre estabilidad y velocidad.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. MÉTRICAS & TRAYECTORIA EMPRESARIAL
     ========================================================================= -->
<section class="about-metrics-section py-5 py-lg-6 bg-light border-top border-bottom" id="trayectoria" aria-labelledby="metrics-title">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="section-eyebrow" data-i18n="about.metrics_eyebrow">Resultados & Trayectoria</span>
            <h2 id="metrics-title" class="section-title" data-i18n="about.metrics_title">Cifras que respaldan nuestro compromiso</h2>
            <p class="section-subtitle text-muted" data-i18n="about.metrics_subtitle">
                Medimos nuestro éxito a través de la estabilidad operativa y el valor sostenido generado para nuestros clientes.
            </p>
        </div>

        <div class="row g-4 text-center">
            <!-- KPI 1 -->
            <div class="col-6 col-lg-3">
                <div class="stat-box p-4 rounded-4 bg-white shadow-sm h-100">
                    <div class="stat-number text-navy mb-2">+50</div>
                    <div class="stat-label fw-bold text-dark mb-1" data-i18n="about.kpi1_label">Proyectos Desplegados</div>
                    <p class="stat-desc text-muted small mb-0" data-i18n="about.kpi1_desc">Sistemas corporativos y aplicaciones web de alta disponibilidad</p>
                </div>
            </div>

            <!-- KPI 2 -->
            <div class="col-6 col-lg-3">
                <div class="stat-box p-4 rounded-4 bg-white shadow-sm h-100">
                    <div class="stat-number text-navy mb-2">99.98%</div>
                    <div class="stat-label fw-bold text-dark mb-1" data-i18n="about.kpi2_label">Uptime Promedio</div>
                    <p class="stat-desc text-muted small mb-0" data-i18n="about.kpi2_desc">Infraestructuras cloud resilientes con balanceo de carga</p>
                </div>
            </div>

            <!-- KPI 3 -->
            <div class="col-6 col-lg-3">
                <div class="stat-box p-4 rounded-4 bg-white shadow-sm h-100">
                    <div class="stat-number text-navy mb-2">100%</div>
                    <div class="stat-label fw-bold text-dark mb-1" data-i18n="about.kpi3_label">Automatización CI/CD</div>
                    <p class="stat-desc text-muted small mb-0" data-i18n="about.kpi3_desc">Pipelines de despliegue continuo con pruebas automatizadas</p>
                </div>
            </div>

            <!-- KPI 4 -->
            <div class="col-6 col-lg-3">
                <div class="stat-box p-4 rounded-4 bg-white shadow-sm h-100">
                    <div class="stat-number text-navy mb-2">+7</div>
                    <div class="stat-label fw-bold text-dark mb-1" data-i18n="about.kpi4_label">Años de Trayectoria</div>
                    <p class="stat-desc text-muted small mb-0" data-i18n="about.kpi4_desc">Resolviendo desafíos de arquitectura y consultoría técnica</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
